# The dashboard's vault route is source code, not secret material. Re-include
# its route module and components after the broad secret-directory exclusions.
!services/ingenium-dashboard/src/app/secrets/
!services/ingenium-dashboard/src/app/secrets/page.tsx
!services/ingenium-dashboard/src/app/secrets/components/
!services/ingenium-dashboard/src/app/secrets/components/**

