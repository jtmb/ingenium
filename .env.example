# ── Required ────────────────────────────────────────────────────────────────────
OPENCODE_SERVER_PASSWORD=<your-opencode-password>
INGENIUM_EMAIL_ENCRYPTION_KEY=<64-hex-char-key-or-64-char-base64url-secret>
# Generated by scripts/bootstrap-local-secrets.sh when absent. The entrypoint
# copies this bootstrap value to a mode-0600 runtime file then clears it before
# starting supervised processes. Never copy a token into a tracked config file;
# the ignored .env is restricted to mode 0600.
INGENIUM_API_TOKEN=
# Alternative to the bootstrap value: a mounted, mode-0600 file visible inside
# the container. When set, it takes precedence over INGENIUM_API_TOKEN.
# INGENIUM_API_TOKEN_FILE=/run/secrets/ingenium-api-token
# ── Optional with defaults ──────────────────────────────────────────────────────
# Comma-separated exact browser origins. Defaults cover local DNS + IPv4
# loopback. Do not use wildcards, paths, credentials, or trailing slashes.
# DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/mail/oauth/callback
