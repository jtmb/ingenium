# Required
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_PASSWORD_FILE=/absolute/path/to/opencode-server.password
INGENIUM_EMAIL_ENCRYPTION_KEY=
INGENIUM_EMAIL_ENCRYPTION_KEY_FILE=/absolute/path/to/email-encryption.key
# Generated by scripts/bootstrap-local-secrets.sh when absent. Compose mounts
# this owner-only host file read-only; entrypoint copies it to the ephemeral
# runtime file consumed by services. Never put token bytes in this file.
INGENIUM_API_TOKEN_FILE=/home/you/.config/ingenium/live-production/installation-api.token
# Optional with defaults
# Comma-separated exact browser origins. Defaults cover local DNS + IPv4
# loopback. Do not use wildcards, paths, credentials, or trailing slashes.
# DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Runtime transport defaults to browser-trusted HTTP on loopback only:
# INGENIUM_RUNTIME_SCHEME=http
# INGENIUM_RUNTIME_ROOT_DOMAIN=runtime.localhost
# INGENIUM_RUNTIME_GATEWAY_BIND_ADDRESS=127.0.0.1
# INGENIUM_RUNTIME_GATEWAY_HOST_PORT=80
# INGENIUM_RUNTIME_GATEWAY_PORT=8080
# Runtime workspace maps may point only at a dedicated read-only validation
# mount. Set both values together when the map contains an authorized workspace.
# INGENIUM_RUNTIME_WORKSPACE_VALIDATION_SOURCE=/absolute/host/workspace
# INGENIUM_RUNTIME_WORKSPACE_VALIDATION_TARGET=/workspace-validation/workspace-id
# Remote/custom runtime domains must explicitly set https, 0.0.0.0, 443, and
# 8443 together and provide trusted wildcard TLS certificate/key files.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/mail/oauth/callback
