{
  "private": true,
  "workspaces": [
    "packages/ingenium-core",
    "packages/ingenium-email",
    "packages/ingenium-extension",
    "services/ingenium-api",
    "services/ingenium-server",
    "services/ingenium-dashboard"
  ],
  "scripts": {
    "build": "node packages/ingenium-extension/scripts/build-root-artifact.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:context-export": "node --test scripts/export-context-upload.test.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.78"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react-dom": "^19.2.3"
  }
}
