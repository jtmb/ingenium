{
  "openapi": "3.1.0",
  "info": {
    "title": "Veyra read-only compatibility edge",
    "version": "0.1.0",
    "description": "Source candidate only. Existing Ingenium API owns identity/RBAC/storage. No writable cutover authorization."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4107"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-ingenium_session"
      }
    },
    "schemas": {
      "Collection": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Opaque existing Project row; IDs, organization ownership, global/archive fields and unknown fields are preserved.",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "requestId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
