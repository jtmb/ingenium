{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "*": "allow",
    "question": "deny",
    "websearch": "allow"
  },
  "agent": {
    "plan": { "permission": { "question": "allow" } },
    "explore": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "browser-agent": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "ingenium-docs": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "ingenium-qa": { "model": "openai/gpt-5.6-terra", "variant": "high" },
    "ingenium-qa-vision": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "ingenium-software-engineer-fast": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "ingenium-software-engineer-premium": { "model": "openai/gpt-5.6-terra", "variant": "max" },
    "ingenium-orchestrator": { "model": "openai/gpt-5.6-sol", "variant": "high" },
    "ingenium-explore": { "model": "openai/gpt-5.6-sol", "variant": "medium" },
    "ingenium-scout": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "ingenium-chat": { "model": "deepseek/deepseek-v4-flash", "variant": "max" },
    "ingenium-security-auditor": { "model": "openai/gpt-5.6-sol", "variant": "high" }
  },
  "mcp": {
    "ingenium": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "node",
        "packages/ingenium-extension/dist/scripts/mcp-server.js"
      ],
      "enabled": true,
      "environment": {
        "PATH": "/home/brajam/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "INGENIUM_API_URL": "http://localhost:4097/api/v1",
        "INGENIUM_API_TOKEN": "{file:.opencode/.ingenium-api-token}",
        "INGENIUM_API_TOKEN_FILE": ".opencode/.ingenium-api-token",
        "INGENIUM_API_TIMEOUT": "10000",
        "LOG_LEVEL": "info"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "playwright-mcp",
        "--caps=vision",
        "--browser",
        "chromium"
      ],
      "enabled": true,
      "environment": {
        "PATH": "/home/brajam/.local/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "timeout": 60000
    }
  },
  "plugin": [
    "./packages/ingenium-extension/plugins/auto-observer.ts",
    "./packages/ingenium-extension/plugins/observer.ts",
    "./packages/ingenium-extension/plugins/resource-sync.ts",
    "./packages/ingenium-extension/ponytail/.opencode/plugins/ponytail.mjs"
  ]
}
