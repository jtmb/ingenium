{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "*": "allow",
    "question": "deny",
    "websearch": "allow"
  },
  "agent": {
    "plan": { "permission": { "question": "allow" } },
    "explore": { "model": "openai/gpt-5.6-luna", "variant": "max" },
    "browser-agent": { "model": "openai/gpt-5.6-luna", "variant": "max", "prompt": "{file:.opencode/agents/execution/browser-agent.md}" },
    "ingenium-docs": { "model": "openai/gpt-5.6-luna", "variant": "max", "prompt": "{file:.opencode/agents/execution/ingenium-docs.md}" },
    "ingenium-qa": { "model": "openai/gpt-5.6-terra", "variant": "high", "prompt": "{file:.opencode/agents/execution/ingenium-qa.md}" },
    "ingenium-qa-vision": { "model": "openai/gpt-5.6-luna", "variant": "max", "prompt": "{file:.opencode/agents/execution/ingenium-qa-vision.md}" },
    "ingenium-software-engineer-fast": { "model": "openai/gpt-5.6-luna", "variant": "max", "prompt": "{file:.opencode/agents/execution/ingenium-software-engineer-fast.md}" },
    "ingenium-software-engineer-premium": { "model": "openai/gpt-5.6-sol", "variant": "high", "prompt": "{file:.opencode/agents/execution/ingenium-software-engineer-premium.md}" },
    "ingenium-orchestrator": { "model": "openai/gpt-5.6-sol", "variant": "high", "prompt": "{file:.opencode/agents/primary/ingenium-orchestrator.md}" },
    "ingenium-explore": { "model": "openai/gpt-5.6-sol", "variant": "medium", "prompt": "{file:.opencode/agents/research/ingenium-explore.md}" },
    "ingenium-scout": { "model": "openai/gpt-5.6-luna", "variant": "max", "prompt": "{file:.opencode/agents/research/ingenium-scout.md}" },
    "ingenium-chat": { "model": "deepseek/deepseek-v4-flash", "variant": "max", "prompt": "{file:.opencode/agents/chat/ingenium-chat.md}" },
    "ingenium-security-auditor": { "model": "openai/gpt-5.6-sol", "variant": "high", "prompt": "{file:.opencode/agents/security/ingenium-security-auditor.md}" }
  },
  "mcp": {
    "ingenium": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "node",
        "{env:PWD}/packages/ingenium-extension/dist/scripts/mcp-server.js"
      ],
      "enabled": true,
      "environment": {
        "PATH": "/home/brajam/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "INGENIUM_API_URL": "http://localhost:4097/api/v1",
        "INGENIUM_MCP_CREDENTIAL_FILE": ".opencode/.ingenium-mcp-credential",
        "INGENIUM_MCP_AUDIENCE": "mcp",
        "INGENIUM_PROJECT": "ingenium",
        "INGENIUM_WORKSPACE_ID": "shared-memory-ingenium",
        "INGENIUM_WORKTREE": "/home/brajam/repos/ingenium",
        "INGENIUM_API_TIMEOUT": "10000",
        "LOG_LEVEL": "info"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "playwright-mcp",
        "--caps=vision",
        "--browser",
        "chromium"
      ],
      "enabled": true,
      "environment": {
        "PATH": "/home/brajam/.local/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "timeout": 60000
    }
  },
  "plugin": [
    "./packages/ingenium-extension/plugins/auto-observer.ts",
    "./packages/ingenium-extension/plugins/observer.ts",
    "./packages/ingenium-extension/plugins/resource-sync.ts",
    "./packages/ingenium-extension/plugins/session-coordinator.ts",
    "./packages/ingenium-extension/ponytail/.opencode/plugins/ponytail.mjs"
  ]
}
