{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "default_agent": "primary/ingenium-orchestrator",
  "experimental": {
    "subagent_depth": 1
  },
  "agents": {
    "plan": {
      "model": "openai/gpt-6-astra#max"
    },
    "research/ingenium-explore": {
      "model": "openai/gpt-6-sol#medium"
    },
    "execution/ingenium-docs": {
      "model": "openai/gpt-6-luna#xhigh"
    },
    "execution/ingenium-qa": {
      "model": "openai/gpt-6-luna#xhigh"
    },
    "execution/ingenium-software-engineer-fast": {
      "model": "openai/gpt-6-luna#xhigh"
    },
    "execution/ingenium-software-engineer-premium": {
      "model": "openai/gpt-6-sol#high"
    },
    "execution/ingenium-recovery-engineer": {
      "model": "openai/gpt-6-sol#high"
    },
    "primary/ingenium-orchestrator": {
      "model": "openai/gpt-6-sol#medium"
    },
    "research/ingenium-scout": {
      "model": "openai/gpt-6-luna#xhigh"
    },
    "chat/ingenium-chat": {
      "model": "openai/gpt-6-luna#xhigh"
    },
    "security/ingenium-security-auditor": {
      "model": "openai/gpt-6-astra#high"
    }
  },
  "mcp": {
    "servers": {
      "ingenium": {
        "type": "local",
        "command": [
          "/usr/bin/env",
          "node",
          "packages/ingenium-extension/dist/scripts/mcp-server.js"
        ],
        "cwd": ".",
        "disabled": false,
        "protocol": "legacy",
        "environment": {
          "INGENIUM_API_URL": "http://localhost:4097/api/v1",
          "INGENIUM_MCP_CREDENTIAL_FILE": ".opencode/.ingenium-mcp-credential",
          "INGENIUM_MCP_AUDIENCE": "mcp",
          "INGENIUM_PROJECT": "ingenium",
          "INGENIUM_WORKSPACE_ID": "shared-memory-ingenium",
          "INGENIUM_WORKTREE": "/home/brajam/repos/ingenium"
        }
      }
    }
  },
  "plugins": [
    "./packages/ingenium-extension/plugins/v2/auto-observer",
    "./packages/ingenium-extension/plugins/v2/observer",
    "./packages/ingenium-extension/plugins/v2/resource-sync",
    "./packages/ingenium-extension/plugins/v2/lifecycle",
    "./packages/ingenium-extension/plugins/v2/ponytail",
    "./packages/ingenium-extension/plugins/v2/goal"
  ]
}
