  pub fn finish_until(&self,deadline:Instant)->Result<()>{
   #[cfg(windows)] {
+   let mut reads=self.web_reads.try_lock().map_err(|_|"retained original reads busy")?;
+   for read in reads.iter(){
+    if !read.is_closed(){
+     if Arc::strong_count(read)!=1{return Err("active original read borrower remains retained".into());}
+     read.retire_never_sent(deadline)?; // sent/unknown cannot use this path
+    }
+   }
+   if reads.iter().any(|read|!read.is_closed()){return Err("original read join/checked close unresolved".into());}
+   reads.clear();
+
    let mut separations=self.separations.try_lock().map_err(|_|"separation originals busy")?;
    if separations.iter().any(|r|Arc::strong_count(r)!=1){return Err("active namespace borrower".into());}
    for original in separations.iter(){original.retire_once(deadline).map_err(|_|"separation checked-close original unresolved")?;}
