+//! Unmounted until the existing authenticated actor and execution owners supply these ports.
+//! No request-body owner, arbitrary directory, hidden Project, transcript store, or raw process launcher.
+use super::*;
+use axum::{Router,Json,http::{HeaderMap,StatusCode},extract::{State,Path},routing::{get,post}};
+use serde::Serialize;
+use sha2::{Digest,Sha256};
+use veyra_contracts::{PrivateWorkspaceCreate as Create,PrivateWorkspaceOriginal as Original,
+    PrivateWorkspaceView as View,PrivateOperationReceipt as Receipt,PrivateOperationState as OpState,
+    PrivateWorkspaceOperation as Operation,PrivateWorkspaceEnvironment as Environment};
+use veyra_adapters::projects::{ProjectStore,PrivateWorkspaceRecord as Record};
+
+/// Constructed only by the existing authenticated native/session/grant adapter. Never Deserialize.
+#[derive(Clone)]
+pub(super) struct VerifiedActor {pub owner_key:String,pub authority_epoch:u64}
+/// The coordinator must map the real principal and current revocation epoch. There is no default implementation.
+pub(super) trait ActorAuthority:Send+Sync {
+    fn resolve(&self,headers:&HeaderMap,action:&str,workspace_id:Option<&str>)->Result<VerifiedActor,StatusCode>;
+}
+/// Actual held native custody, not a serializable metadata/path grant.
+pub(super) trait CapturedPrivateWorkspace:Send+Sync {
+    fn workspace_id(&self)->&str;
+    fn owner_key(&self)->&str;
+    fn directory(&self)->&str;
+    fn root_identity(&self)->&str;
+    fn verify(&self)->bool;
+}
+/// Implement on the existing process/engine owner. Do not instantiate a second terminal manager,
+/// construct a Project, change the inference engine, or add a transcript authority.
+pub(super) trait ExecutionOwner:Send+Sync {
+    fn supports_environment(&self,environment:&Environment)->bool;
+    fn supports_operation(&self,operation:&Operation,environment:&Environment)->bool;
+    fn prepare_once(&self,actor:&VerifiedActor,request:&Create)->Result<Box<dyn CapturedPrivateWorkspace>,StatusCode>;
+    fn acquire_existing(&self,actor:&VerifiedActor,record:&Record)->Result<Box<dyn CapturedPrivateWorkspace>,StatusCode>;
+    /// Consume the same custody and invoke check immediately at real effect admission; retain all late failures.
+    /// Existing approval/sandbox/drain/process ownership and engine-session originals still apply.
+    fn execute_once(&self,lease:&dyn CapturedPrivateWorkspace,actor:&VerifiedActor,original:&Original,
+        check:&dyn Fn()->Result<(),StatusCode>)->Result<(OpState,Option<String>),StatusCode>;
+}
+pub(super) struct Boundary {
+    pub state:Arc<ServiceState>,
+    pub authority:Arc<dyn ActorAuthority>,
+    pub execution:Arc<dyn ExecutionOwner>,
+}
+pub(super) fn router(boundary:Arc<Boundary>)->Router<Arc<ServiceState>> {
+    Router::new().route("/",post(create)).route("/{id}",get(read))
+        .route("/{id}/operations",post(execute)).route("/{id}/operations/{request_id}",get(receipt))
+        .layer(axum::extract::DefaultBodyLimit::max(512*1024)).with_state(boundary)
+}
+fn valid_id(value:&str)->bool {uuid::Uuid::parse_str(value).is_ok_and(|id|!id.is_nil() && id.to_string()==value)}
+fn hash<T:Serialize>(value:&T)->Result<String,StatusCode> {
+    fn ordered(value:serde_json::Value)->Result<serde_json::Value,StatusCode> {
+        match value {
+            serde_json::Value::Object(values)=>{
+                let values=values.into_iter().map(|(k,v)|Ok((k,ordered(v)?)))
+                    .collect::<Result<std::collections::BTreeMap<_,_>,StatusCode>>()?;
+                serde_json::to_value(values).map_err(|_|StatusCode::BAD_REQUEST)
+            }
+            serde_json::Value::Array(values)=>Ok(serde_json::Value::Array(
+                values.into_iter().map(ordered).collect::<Result<Vec<_>,_>>()?)),
+            value=>Ok(value),
+        }
+    }
+    let value=ordered(serde_json::to_value(value).map_err(|_|StatusCode::BAD_REQUEST)?)?;
+    Ok(format!("{:x}",Sha256::digest(serde_json::to_vec(&value).map_err(|_|StatusCode::BAD_REQUEST)?)))
+}
+fn actor(boundary:&Boundary,headers:&HeaderMap,action:&str,id:Option<&str>)->Result<VerifiedActor,StatusCode> {
+    let actor=boundary.authority.resolve(headers,action,id)?;
+    if actor.owner_key.len()!=64 || !actor.owner_key.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || actor.authority_epoch>i64::MAX as u64 {return Err(StatusCode::FORBIDDEN);}
+    Ok(actor)
+}
+fn valid_environment(environment:&Environment)->bool {
+    match environment {
+        Environment::Windows=>true,
+        Environment::Wsl{distro,user}=>[distro,user].iter().all(|value|!value.is_empty() && value.len()<=256 && !value.chars().any(char::is_control)),
+    }
+}
+fn same_actor(a:&VerifiedActor,b:&VerifiedActor)->Result<(),StatusCode> {
+    if a.owner_key==b.owner_key && a.authority_epoch==b.authority_epoch {Ok(())} else {Err(StatusCode::FORBIDDEN)}
+}
+fn view(boundary:&Boundary,actor:&VerifiedActor,record:Record)->View {
+    View {project_id:(),id:record.id,revision:record.revision,state:record.state,environment:record.environment,
+        service_instance_id:boundary.state.instance_id.clone(),authority_epoch:actor.authority_epoch,
+        directory:record.directory,root_identity:record.root_identity}
+}
+fn store_error(error:veyra_adapters::projects::StoreError)->StatusCode {
+    use veyra_adapters::projects::StoreError as E;
+    match error {E::Invalid=>StatusCode::BAD_REQUEST,E::NotFound=>StatusCode::NOT_FOUND,
+        E::Conflict=>StatusCode::CONFLICT,_=>StatusCode::SERVICE_UNAVAILABLE}
+}
+async fn storage<T:Send+'static>(boundary:Arc<Boundary>,
+    action:impl FnOnce(&mut ProjectStore)->Result<T,veyra_adapters::projects::StoreError>+Send+'static)->Result<T,StatusCode> {
+    tokio::task::spawn_blocking(move||{
+        let mut store=boundary.state.projects.lock().map_err(|_|StatusCode::SERVICE_UNAVAILABLE)?;
+        action(store.as_mut().ok_or(StatusCode::SERVICE_UNAVAILABLE)?).map_err(store_error)
+    }).await.map_err(|_|StatusCode::SERVICE_UNAVAILABLE)?
+}
+fn verify(lease:&dyn CapturedPrivateWorkspace,actor:&VerifiedActor,record:&Record)->Result<(),StatusCode> {
+    if lease.workspace_id()!=record.id || lease.owner_key()!=actor.owner_key || !lease.verify()
+        || lease.directory().is_empty() || lease.root_identity().is_empty() {return Err(StatusCode::CONFLICT);}
+    if record.state=="active" && (record.directory.as_deref()!=Some(lease.directory()) ||
+        record.root_identity.as_deref()!=Some(lease.root_identity())) {return Err(StatusCode::CONFLICT);}
+    Ok(())
+}
+async fn create(State(boundary):State<Arc<Boundary>>,headers:HeaderMap,Json(request):Json<Create>)
+    ->Result<(StatusCode,Json<View>),StatusCode> {
+    if !valid_id(&request.request_id) || !valid_id(&request.workspace_id) ||
+        request.service_instance_id!=boundary.state.instance_id || !valid_environment(&request.environment) {return Err(StatusCode::CONFLICT);}
+    let who=actor(&boundary,&headers,"private-workspaces:create",None)?;
+    if who.authority_epoch!=request.authority_epoch {return Err(StatusCode::CONFLICT);}
+    if !boundary.execution.supports_environment(&request.environment) {return Err(StatusCode::NOT_IMPLEMENTED);}
+    let digest=hash(&request)?;let key=who.owner_key.clone();let original=request.clone();
+    let (fresh,record)=storage(boundary.clone(),move|store|store.reserve_private_workspace(&key,&original,&digest)).await?;
+    if !fresh {let status=if record.state=="active"{StatusCode::OK}else{StatusCode::ACCEPTED};
+        return Ok((status,Json(view(&boundary,&who,record))));}
+    let execution=boundary.execution.clone();let original=request.clone();let captured_actor=who.clone();
+    let captured_record=record.clone();
+    let captured=tokio::task::spawn_blocking(move||{
+        let lease=execution.prepare_once(&captured_actor,&original)?;
+        verify(lease.as_ref(),&captured_actor,&captured_record)?;
+        Ok::<_,StatusCode>(lease)
+    }).await.map_err(|_|StatusCode::SERVICE_UNAVAILABLE);
+    let activated=match captured {
+        Ok(Ok(lease))=>{
+            let current=actor(&boundary,&headers,"private-workspaces:create",Some(&record.id));
+            if current.as_ref().is_ok_and(|current|same_actor(&who,current).is_ok()) {
+                let key=who.owner_key.clone();let id=record.id.clone();
+                let directory=lease.directory().to_owned();let identity=lease.root_identity().to_owned();
+                storage(boundary.clone(),move|store|store.activate_private_workspace(&key,&id,&directory,&identity)).await
+            } else {Err(StatusCode::FORBIDDEN)}
+        }
+        _=>Err(StatusCode::SERVICE_UNAVAILABLE),
+    };
+    match activated {
+        Ok(record)=>Ok((StatusCode::CREATED,Json(view(&boundary,&who,record)))),
+        Err(_)=>{
+            let key=who.owner_key.clone();let id=record.id;
+            let record=storage(boundary.clone(),move|store|store.mark_private_workspace_unknown(&key,&id)).await?;
+            Ok((StatusCode::ACCEPTED,Json(view(&boundary,&who,record))))
+        }
+    }
+}
+async fn read(State(boundary):State<Arc<Boundary>>,headers:HeaderMap,Path(id):Path<String>)
+    ->Result<Json<View>,StatusCode> {
+    let who=actor(&boundary,&headers,"private-workspaces:read",Some(&id))?;let key=who.owner_key.clone();
+    let record=storage(boundary.clone(),move|store|store.private_workspace(&key,&id)).await?;
+    Ok(Json(view(&boundary,&who,record)))
+}
+fn operation_valid(operation:&Operation)->bool {
+    match operation {
+        Operation::TerminalOpen{shell,columns,rows}=>!shell.is_empty() && shell.len()<=32 &&
+            !shell.chars().any(char::is_control) && (20..=300).contains(columns) && (5..=120).contains(rows),
+        Operation::TerminalResize{terminal_id,columns,rows}=>valid_id(terminal_id) &&
+            (20..=300).contains(columns) && (5..=120).contains(rows),
+        Operation::TerminalInput{terminal_id,text}=>valid_id(terminal_id) && !text.is_empty() && text.len()<=65536,
+        Operation::TerminalClose{terminal_id}=>valid_id(terminal_id),
+        Operation::AgentTurn{conversation_ref,original_turn_ref}=>[conversation_ref,original_turn_ref].iter()
+            .all(|value|!value.is_empty() && value.len()<=4096 && !value.chars().any(char::is_control)),
+    }
+}
+async fn execute(State(boundary):State<Arc<Boundary>>,headers:HeaderMap,Path(id):Path<String>,Json(original):Json<Original>)
+    ->Result<(StatusCode,Json<Receipt>),StatusCode> {
+    if id!=original.workspace_id || !valid_id(&id) || !valid_id(&original.request_id) ||
+        original.service_instance_id!=boundary.state.instance_id || !operation_valid(&original.operation) {
+        return Err(StatusCode::CONFLICT);
+    }
+    let action=format!("private-workspaces:execute:{}",original.operation.kind());
+    let who=actor(&boundary,&headers,&action,Some(&id))?;
+    if who.authority_epoch!=original.authority_epoch {return Err(StatusCode::CONFLICT);}
+    let key=who.owner_key.clone();let workspace_id=id.clone();
+    let record=storage(boundary.clone(),move|store|store.private_workspace(&key,&workspace_id)).await?;
+    if record.state!="active" || record.revision!=original.expected_revision {return Err(StatusCode::CONFLICT);}
+    if !boundary.execution.supports_operation(&original.operation,&record.environment) {return Err(StatusCode::NOT_IMPLEMENTED);}
+    let digest=hash(&original)?;let key=who.owner_key.clone();let request=original.clone();
+    let (fresh,saved)=storage(boundary.clone(),move|store|store.reserve_private_operation(&key,&request,&digest)).await?;
+    if !fresh {return Ok((receipt_status(&saved),Json(saved)));}
+    let service=boundary.clone();let captured_actor=who.clone();let request=original.clone();
+    let effect=tokio::task::spawn_blocking(move||{
+        let lease=service.execution.acquire_existing(&captured_actor,&record)?;
+        let check=||{
+            verify(lease.as_ref(),&captured_actor,&record)?;
+            {
+                let store=service.state.projects.lock().map_err(|_|StatusCode::SERVICE_UNAVAILABLE)?;
+                let current=store.as_ref().ok_or(StatusCode::SERVICE_UNAVAILABLE)?
+                    .private_workspace(&captured_actor.owner_key,&record.id).map_err(store_error)?;
+                if current.state!="active" || current.revision!=record.revision ||
+                    current.directory!=record.directory || current.root_identity!=record.root_identity {
+                    return Err(StatusCode::CONFLICT);
+                }
+            }
+            let current=actor(&service,&headers,&action,Some(&record.id))?;
+            same_actor(&captured_actor,&current)
+        };
+        check()?;
+        service.execution.execute_once(lease.as_ref(),&captured_actor,&request,&check)
+    }).await;
+    let (state,result_ref)=match effect {Ok(Ok((state,result))) if state!=OpState::Pending=>(state,result),
+        _=>(OpState::Unknown,None)};
+    let key=who.owner_key;let workspace_id=id;let request_id=original.request_id;
+    let saved=storage(boundary.clone(),move|store|store.settle_private_operation(&key,&workspace_id,&request_id,state,result_ref.as_deref())).await?;
+    Ok((receipt_status(&saved),Json(saved)))
+}
+fn receipt_status(receipt:&Receipt)->StatusCode {
+    if matches!(receipt.state,OpState::Pending|OpState::Unknown) {StatusCode::ACCEPTED} else {StatusCode::OK}
+}
+async fn receipt(State(boundary):State<Arc<Boundary>>,headers:HeaderMap,Path((id,request_id)):Path<(String,String)>)
+    ->Result<Json<Receipt>,StatusCode> {
+    let who=actor(&boundary,&headers,"private-workspaces:read",Some(&id))?;
+    Ok(Json(storage(boundary,move|store|store.private_operation(&who.owner_key,&id,&request_id)).await?))
+}
