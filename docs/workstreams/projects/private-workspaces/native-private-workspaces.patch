+//! Additive private scope metadata in the existing ProjectStore connection.
+//! Directory allocation, process custody and engine transcripts stay with their current owners.
+use super::*;
+use veyra_contracts::{PrivateWorkspaceCreate,PrivateWorkspaceOriginal,PrivateOperationReceipt,PrivateOperationState};
+const COLUMNS:&str="id,owner_key,environment,revision,state,directory,root_identity,create_request_id,create_sha256,created_instance_id";
+
+/// Existing-writer metadata; deliberately not serializable as execution authority.
+#[derive(Clone)]
+pub struct PrivateWorkspaceRecord {
+    pub id:String,pub owner_key:String,pub environment:veyra_contracts::PrivateWorkspaceEnvironment,
+    pub revision:u32,pub state:String,pub directory:Option<String>,pub root_identity:Option<String>,
+    pub create_request_id:String,pub create_sha256:String,pub created_instance_id:String,
+}
+fn record(row:&rusqlite::Row<'_>)->rusqlite::Result<PrivateWorkspaceRecord> {
+    let environment:String=row.get(2)?;
+    Ok(PrivateWorkspaceRecord {id:row.get(0)?,owner_key:row.get(1)?,
+        environment:serde_json::from_str(&environment).map_err(|_|rusqlite::Error::InvalidQuery)?,
+        revision:row.get(3)?,state:row.get(4)?,directory:row.get(5)?,root_identity:row.get(6)?,
+        create_request_id:row.get(7)?,create_sha256:row.get(8)?,created_instance_id:row.get(9)?})
+}
+fn owner(value:&str)->Result<(),StoreError> {
+    if value.len()==64 && value.bytes().all(|b|b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {Ok(())}
+    else {Err(StoreError::Invalid)}
+}
+fn id(value:&str)->Result<(),StoreError> {
+    if uuid::Uuid::parse_str(value).is_ok_and(|id|!id.is_nil() && id.to_string()==value) {Ok(())}
+    else {Err(StoreError::Invalid)}
+}
+fn operation(row:&rusqlite::Row<'_>)->rusqlite::Result<PrivateOperationReceipt> {
+    let state:String=row.get(7)?;
+    let state=match state.as_str() {"pending"=>PrivateOperationState::Pending,"succeeded"=>PrivateOperationState::Succeeded,
+        "failed"=>PrivateOperationState::Failed,"unknown"=>PrivateOperationState::Unknown,_=>return Err(rusqlite::Error::InvalidQuery)};
+    Ok(PrivateOperationReceipt {project_id:(),workspace_id:row.get(0)?,request_id:row.get(1)?,
+        workspace_revision:row.get(2)?,service_instance_id:row.get(3)?,authority_epoch:row.get(4)?,
+        original_sha256:row.get(5)?,state,result_ref:row.get(8)?})
+}
+const OP_COLUMNS:&str="workspace_id,request_id,workspace_revision,service_instance_id,authority_epoch,original_sha256,operation_kind,state,result_ref";
+
+impl ProjectStore {
+    /// Reserve exact creation before filesystem work. A repeated/unknown original never allocates again.
+    pub fn reserve_private_workspace(&mut self,owner_key:&str,request:&PrivateWorkspaceCreate,sha256:&str)
+        ->Result<(bool,PrivateWorkspaceRecord),StoreError> {
+        owner(owner_key)?;owner(sha256)?;id(&request.workspace_id)?;id(&request.request_id)?;id(&request.service_instance_id)?;
+        let tx=self.connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
+        let prior=tx.query_row(&format!("SELECT {COLUMNS} FROM private_workspaces WHERE owner_key=?1 AND create_request_id=?2"),
+            params![owner_key,request.request_id],record).optional()?;
+        if let Some(prior)=prior {
+            if prior.create_sha256!=sha256 || prior.id!=request.workspace_id {return Err(StoreError::Conflict);}
+            tx.commit()?;return Ok((false,prior));
+        }
+        if tx.query_row("SELECT 1 FROM private_workspaces WHERE id=?1",params![request.workspace_id],|_|Ok(())).optional()?.is_some() {
+            return Err(StoreError::Conflict);
+        }
+        let environment=serde_json::to_string(&request.environment).map_err(|_|StoreError::Invalid)?;
+        tx.execute("INSERT INTO private_workspaces(id,owner_key,environment,state,create_request_id,create_sha256,created_instance_id)
+            VALUES(?1,?2,?3,'pending',?4,?5,?6)",params![request.workspace_id,owner_key,environment,request.request_id,sha256,request.service_instance_id])?;
+        let saved=tx.query_row(&format!("SELECT {COLUMNS} FROM private_workspaces WHERE id=?1 AND owner_key=?2"),
+            params![request.workspace_id,owner_key],record)?;
+        tx.commit()?;Ok((true,saved))
+    }
+    /// Read only through authenticated ownership. No missing-row fallback or directory creation.
+    pub fn private_workspace(&self,owner_key:&str,workspace_id:&str)->Result<PrivateWorkspaceRecord,StoreError> {
+        owner(owner_key)?;id(workspace_id)?;
+        self.connection.query_row(&format!("SELECT {COLUMNS} FROM private_workspaces WHERE id=?1 AND owner_key=?2"),
+            params![workspace_id,owner_key],record).optional()?.ok_or(StoreError::NotFound)
+    }
+    /// Persist an actually captured root. This metadata does not confer execution authority.
+    pub fn activate_private_workspace(&mut self,owner_key:&str,workspace_id:&str,directory:&str,identity:&str)
+        ->Result<PrivateWorkspaceRecord,StoreError> {
+        owner(owner_key)?;id(workspace_id)?;
+        if directory.is_empty() || directory.len()>32760 || directory.chars().any(char::is_control)
+            || identity.is_empty() || identity.len()>4096 || identity.chars().any(char::is_control) {return Err(StoreError::Invalid);}
+        if self.connection.execute("UPDATE private_workspaces SET state='active',directory=?1,root_identity=?2,revision=revision+1
+            WHERE id=?3 AND owner_key=?4 AND state='pending'",params![directory,identity,workspace_id,owner_key])?!=1 {
+            return Err(StoreError::Conflict);
+        }
+        self.private_workspace(owner_key,workspace_id)
+    }
+    /// Unknown roots/intents remain retained for owner reconciliation; this never deletes files.
+    pub fn mark_private_workspace_unknown(&mut self,owner_key:&str,workspace_id:&str)->Result<PrivateWorkspaceRecord,StoreError> {
+        owner(owner_key)?;id(workspace_id)?;
+        self.connection.execute("UPDATE private_workspaces SET state='unknown' WHERE id=?1 AND owner_key=?2 AND state='pending'",
+            params![workspace_id,owner_key])?;
+        self.private_workspace(owner_key,workspace_id)
+    }
+    /// The same native writer reserves effects; command/prompt bodies are not copied into this table.
+    pub fn reserve_private_operation(&mut self,owner_key:&str,request:&PrivateWorkspaceOriginal,sha256:&str)
+        ->Result<(bool,PrivateOperationReceipt),StoreError> {
+        owner(owner_key)?;owner(sha256)?;id(&request.workspace_id)?;id(&request.request_id)?;id(&request.service_instance_id)?;
+        let tx=self.connection.transaction_with_behavior(TransactionBehavior::Immediate)?;
+        let prior=tx.query_row(&format!("SELECT {OP_COLUMNS} FROM private_workspace_operations WHERE owner_key=?1 AND request_id=?2"),
+            params![owner_key,request.request_id],operation).optional()?;
+        if let Some(prior)=prior {
+            if prior.original_sha256!=sha256 || prior.workspace_id!=request.workspace_id {return Err(StoreError::Conflict);}
+            tx.commit()?;return Ok((false,prior));
+        }
+        let current=tx.query_row(&format!("SELECT {COLUMNS} FROM private_workspaces WHERE id=?1 AND owner_key=?2"),
+            params![request.workspace_id,owner_key],record).optional()?.ok_or(StoreError::NotFound)?;
+        if current.state!="active" || current.revision!=request.expected_revision {return Err(StoreError::Conflict);}
+        tx.execute("INSERT INTO private_workspace_operations(owner_key,request_id,workspace_id,workspace_revision,
+            service_instance_id,authority_epoch,original_sha256,operation_kind,state) VALUES(?1,?2,?3,?4,?5,?6,?7,?8,'pending')",
+            params![owner_key,request.request_id,request.workspace_id,request.expected_revision,request.service_instance_id,
+                request.authority_epoch,sha256,request.operation.kind()])?;
+        let saved=tx.query_row(&format!("SELECT {OP_COLUMNS} FROM private_workspace_operations WHERE owner_key=?1 AND request_id=?2"),
+            params![owner_key,request.request_id],operation)?;
+        tx.commit()?;Ok((true,saved))
+    }
+    /// Observe a prior original after reconnect/restart; absence never authorizes replay.
+    pub fn private_operation(&self,owner_key:&str,workspace_id:&str,request_id:&str)->Result<PrivateOperationReceipt,StoreError> {
+        owner(owner_key)?;id(workspace_id)?;id(request_id)?;
+        self.connection.query_row(&format!("SELECT {OP_COLUMNS} FROM private_workspace_operations
+            WHERE owner_key=?1 AND workspace_id=?2 AND request_id=?3"),params![owner_key,workspace_id,request_id],operation)
+            .optional()?.ok_or(StoreError::NotFound)
+    }
+    /// Settle only the retained pending original using an observation from the existing effect owner.
+    pub fn settle_private_operation(&mut self,owner_key:&str,workspace_id:&str,request_id:&str,state:PrivateOperationState,result_ref:Option<&str>)
+        ->Result<PrivateOperationReceipt,StoreError> {
+        owner(owner_key)?;id(workspace_id)?;id(request_id)?;
+        let state=match state {PrivateOperationState::Succeeded=>"succeeded",PrivateOperationState::Failed=>"failed",
+            PrivateOperationState::Unknown=>"unknown",PrivateOperationState::Pending=>return Err(StoreError::Invalid)};
+        self.connection.execute("UPDATE private_workspace_operations SET state=?1,result_ref=?2
+            WHERE owner_key=?3 AND workspace_id=?4 AND request_id=?5 AND state='pending'",
+            params![state,result_ref,owner_key,workspace_id,request_id])?;
+        self.private_operation(owner_key,workspace_id,request_id)
+    }
+}
+pub(super) fn validate_absent(connection:&Connection)->Result<(),StoreError> {
+    let count:i64=connection.query_row("SELECT count(*) FROM sqlite_master WHERE name IN
+        ('private_workspaces','private_workspace_operations','private_workspaces_owner')",[],|row|row.get(0))?;
+    if count==0 {Ok(())} else {Err(StoreError::Corrupt)}
+}
+pub(super) fn validate(connection:&Connection)->Result<(),StoreError> {
+    let template=include_str!("0006.sql");
+    for (kind,name) in [("TABLE","private_workspaces"),("TABLE","private_workspace_operations"),("INDEX","private_workspaces_owner")] {
+        let marker=format!("CREATE {kind} {name}");
+        let start=template.find(&marker).ok_or(StoreError::Corrupt)?;
+        let expected=template[start..].split(';').next().ok_or(StoreError::Corrupt)?;
+        let actual:String=connection.query_row("SELECT sql FROM sqlite_master WHERE name=?1",params![name],|row|row.get(0))?;
+        fn normalized(sql:&str)->String {sql.chars().filter(|c|!c.is_whitespace()).flat_map(char::to_lowercase).collect()}
+        if normalized(&actual)!=normalized(expected) {return Err(StoreError::Corrupt);}
+    }
+    let invalid:i64=connection.query_row("SELECT count(*) FROM private_workspace_operations o LEFT JOIN private_workspaces w ON w.id=o.workspace_id AND w.owner_key=o.owner_key WHERE w.id IS NULL",[],|row|row.get(0))?;
+    if invalid!=0 {return Err(StoreError::Corrupt);}
+    for (table,expected) in [
+        ("private_workspaces",vec!["id","owner_key","environment","revision","state","create_request_id","create_sha256","created_instance_id","directory","root_identity"]),
+        ("private_workspace_operations",vec!["owner_key","request_id","workspace_id","workspace_revision","service_instance_id","authority_epoch","original_sha256","operation_kind","state","result_ref"]),
+    ] {
+        let mut statement=connection.prepare(&format!("PRAGMA table_info({table})"))?;
+        let actual=statement.query_map([],|row|row.get::<_,String>(1))?.collect::<Result<Vec<_>,_>>()?;
+        if actual!=expected {return Err(StoreError::Corrupt);}
+    }
+    let mut statement=connection.prepare(&format!("SELECT {COLUMNS} FROM private_workspaces"))?;
+    for item in statement.query_map([],record)? {let row=item?;owner(&row.owner_key)?;owner(&row.create_sha256)?;id(&row.id)?;id(&row.create_request_id)?;id(&row.created_instance_id)?;}
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
