+        let connection=Connection::open_in_memory().expect("in-memory fixture");
+        connection.execute_batch(include_str!("0001.sql")).expect("v1");
+        connection.execute_batch(include_str!("0002.sql")).expect("v2");
+        connection.execute_batch(include_str!("0003.sql")).expect("v3");
+        connection.execute_batch(include_str!("0004.sql")).expect("v4");
+        connection.execute_batch(include_str!("0005.sql")).expect("v5");
+        connection.execute_batch(include_str!("0006.sql")).expect("v6");
