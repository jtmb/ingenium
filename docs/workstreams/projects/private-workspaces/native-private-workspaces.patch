+//! Private working areas are execution scope, never organization projects or transcript owners.
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+/// Execution environment for private roots; unknown nested fields and implicit WSL users are rejected.
+#[derive(Clone, Serialize, Deserialize, TS)]
+#[serde(tag="kind",rename_all="snake_case",deny_unknown_fields)]
+pub enum PrivateWorkspaceEnvironment { Windows,Wsl {distro:String,user:String} }
+impl PrivateWorkspaceEnvironment {
+    /// Translate environment metadata only; this does not create a Project or authorize execution.
+    pub fn native(&self)->crate::ExecutionEnvironment {
+        match self {
+            Self::Windows=>crate::ExecutionEnvironment::Windows,
+            Self::Wsl{distro,user}=>crate::ExecutionEnvironment::Wsl{distro:distro.clone(),user:Some(user.clone())},
+        }
+    }
+}
+#[derive(Clone, Serialize, Deserialize, TS)]
+#[serde(rename_all="camelCase",deny_unknown_fields)]
+pub struct PrivateWorkspaceCreate {
+    pub request_id:String,
+    pub workspace_id:String,
+    pub environment:PrivateWorkspaceEnvironment,
+    pub service_instance_id:String,
+    pub authority_epoch:u64,
+}
+#[derive(Clone, Serialize, Deserialize, TS)]
+#[serde(rename_all="camelCase",deny_unknown_fields)]
+pub struct PrivateWorkspaceView {
+    pub project_id:(),
+    pub id:String,
+    pub revision:u32,
+    pub state:String,
+    pub environment:PrivateWorkspaceEnvironment,
+    pub service_instance_id:String,
+    pub authority_epoch:u64,
+    pub directory:Option<String>,
+    pub root_identity:Option<String>,
+}
+#[derive(Clone, Serialize, Deserialize, TS)]
+#[serde(tag="kind",rename_all="snake_case",deny_unknown_fields)]
+pub enum PrivateWorkspaceOperation {
+    TerminalOpen { shell:String, columns:u16, rows:u16 },
+    TerminalInput { #[serde(rename="terminalId")] terminal_id:String, text:String },
+    TerminalResize { #[serde(rename="terminalId")] terminal_id:String, columns:u16, rows:u16 },
+    TerminalClose { #[serde(rename="terminalId")] terminal_id:String },
+    AgentTurn {
+        #[serde(rename="conversationRef")] conversation_ref:String,
+        #[serde(rename="originalTurnRef")] original_turn_ref:String,
+    },
+}
+impl PrivateWorkspaceOperation {
+    /// This label is policy metadata, never a shell command or permission grant.
+    pub fn kind(&self)->&'static str {
+        match self {
+            Self::TerminalOpen{..}=>"terminal_open",Self::TerminalInput{..}=>"terminal_input",
+            Self::TerminalResize{..}=>"terminal_resize",Self::TerminalClose{..}=>"terminal_close",
+            Self::AgentTurn{..}=>"agent_turn",
+        }
+    }
+}
+#[derive(Clone, Serialize, Deserialize, TS)]
+#[serde(rename_all="camelCase",deny_unknown_fields)]
+pub struct PrivateWorkspaceOriginal {
+    pub project_id:(),
+    pub workspace_id:String,
+    pub expected_revision:u32,
+    pub service_instance_id:String,
+    pub authority_epoch:u64,
+    pub request_id:String,
+    pub operation:PrivateWorkspaceOperation,
+}
+#[derive(Debug,Clone,Copy,PartialEq,Eq,Serialize,Deserialize,TS)]
+#[serde(rename_all="snake_case")]
+pub enum PrivateOperationState { Pending,Succeeded,Failed,Unknown }
+#[derive(Clone,Serialize,Deserialize,TS)]
+#[serde(rename_all="camelCase",deny_unknown_fields)]
+pub struct PrivateOperationReceipt {
+    pub project_id:(),
+    pub workspace_id:String,
+    pub request_id:String,
+    pub workspace_revision:u32,
+    pub service_instance_id:String,
+    pub authority_epoch:u64,
+    pub original_sha256:String,
+    pub state:PrivateOperationState,
+    pub result_ref:Option<String>,
+}
+pub(crate) fn declarations(cfg:&ts_rs::Config)->Vec<String> {
+    vec![PrivateWorkspaceEnvironment::decl(cfg),PrivateWorkspaceCreate::decl(cfg),PrivateWorkspaceView::decl(cfg),PrivateWorkspaceOperation::decl(cfg),
+        PrivateWorkspaceOriginal::decl(cfg),PrivateOperationState::decl(cfg),PrivateOperationReceipt::decl(cfg)]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn private_workspace_contract_rejects_nested_path_and_project_identity() {
+        let mut request=serde_json::json!({
+            "requestId":"22222222-2222-4222-8222-222222222222",
+            "workspaceId":"11111111-1111-4111-8111-111111111111",
+            "environment":{"kind":"windows"},
+            "serviceInstanceId":"33333333-3333-4333-8333-333333333333","authorityEpoch":7
+        });
+        assert!(serde_json::from_value::<PrivateWorkspaceCreate>(request.clone()).is_ok());
+        request["environment"]["directory"]=serde_json::json!("C:/forged");
+        assert!(serde_json::from_value::<PrivateWorkspaceCreate>(request).is_err());
+        let original=serde_json::json!({
+            "projectId":"hidden-project","workspaceId":"11111111-1111-4111-8111-111111111111",
+            "expectedRevision":2,"serviceInstanceId":"33333333-3333-4333-8333-333333333333",
+            "authorityEpoch":7,"requestId":"55555555-5555-4555-8555-555555555555",
+            "operation":{"kind":"terminal_close","terminalId":"66666666-6666-4666-8666-666666666666"}
+        });
+        assert!(serde_json::from_value::<PrivateWorkspaceOriginal>(original).is_err());
+    }
+}
