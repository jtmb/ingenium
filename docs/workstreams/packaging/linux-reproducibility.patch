diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,12 +1,18 @@
 # Compile workspace artifacts in the same glibc family as runtime so copied
 # native Node modules remain loadable.
-FROM node:22-slim AS builder
+ARG SOURCE_DATE_EPOCH
+FROM node:22-bookworm-slim@sha256:9f0dde62d10e7ff7a310ecaebd66225f6b46c17e6cb778449a77b05d3541bea2 AS builder
 WORKDIR /app
+COPY --chown=root:root --chmod=0444 tools/veyra-release/reproducible-linux.mjs /usr/local/libexec/veyra/reproducible-linux.mjs
+COPY --chown=root:root --chmod=0444 tools/veyra-release/linux-build.lock.json /usr/local/share/veyra/linux-build.lock.json
+RUN VEYRA_IMAGE_BUILD_CONTEXT=1 node /usr/local/libexec/veyra/reproducible-linux.mjs configure /usr/local/share/veyra/linux-build.lock.json

 # Native modules such as better-sqlite3 can fall back to node-gyp when a
 # prebuilt binary is unavailable. These build-only tools never enter runtime.
-RUN apt-get update && apt-get install -y --no-install-recommends \
-    python3 make g++ ca-certificates && \
+RUN export VEYRA_IMAGE_BUILD_CONTEXT=1; apt-get update --error-on=any && \
+    node /usr/local/libexec/veyra/reproducible-linux.mjs verify-indexes /usr/local/share/veyra/linux-build.lock.json && \
+    apt-get install -y --no-install-recommends python3 make g++ ca-certificates && \
+    node /usr/local/libexec/veyra/reproducible-linux.mjs capture-os /usr/local/share/veyra/linux-build.lock.json /usr/local/share/veyra/builder-os-inputs.json && \
     rm -rf /var/lib/apt/lists/*

 COPY package.json package-lock.json ./
@@ -22,6 +28,10 @@
 RUN npm ci --workspaces --include-workspace-root

 COPY . .
+ARG IMAGE_REVISION
+ARG IMAGE_SOURCE_SHA256
+ARG SOURCE_DATE_EPOCH
+RUN VEYRA_IMAGE_BUILD_CONTEXT=1 node /usr/local/libexec/veyra/reproducible-linux.mjs capture-source /usr/local/share/veyra/linux-build.lock.json /usr/local/share/veyra/source-inputs.json
 RUN sh scripts/validate-deployment-config.sh
 RUN node packages/ingenium-extension/scripts/plugin-source-closure.mjs \
       --materialize /tmp/ingenium-extension-plugin-sources
@@ -63,21 +73,28 @@
