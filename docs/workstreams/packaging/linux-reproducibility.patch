+RUN export VEYRA_IMAGE_BUILD_CONTEXT=1; playwright_cli="$(node -e 'const r = require("node:module").createRequire(require.resolve("@playwright/mcp")); process.stdout.write(require("node:path").join(require("node:path").dirname(r.resolve("playwright/package.json")), "cli.js"))')" && \
     PLAYWRIGHT_BROWSERS_PATH=/opt/ingenium-playwright/browsers node "$playwright_cli" install --with-deps chromium && \
+    node /usr/local/libexec/veyra/reproducible-linux.mjs verify-indexes /usr/local/share/veyra/linux-build.lock.json && \
+    node /usr/local/libexec/veyra/reproducible-linux.mjs capture-os /usr/local/share/veyra/linux-build.lock.json /usr/local/share/veyra/runtime-os-inputs.json && \
+    rm -rf /var/lib/apt/lists/* && \
     browser_path="$(PLAYWRIGHT_BROWSERS_PATH=/opt/ingenium-playwright/browsers node -e 'process.stdout.write(require("node:module").createRequire(require.resolve("@playwright/mcp"))("playwright").chromium.executablePath())')" && \
     test -x "$browser_path" && \
     ln -s "$browser_path" /opt/ingenium-playwright/chromium && \
     test "$(realpath /opt/ingenium-playwright/chromium)" = "$browser_path"
+COPY --from=builder --chown=root:root --chmod=0444 /usr/local/share/veyra/builder-os-inputs.json /usr/local/share/veyra/builder-os-inputs.json
+COPY --from=builder --chown=root:root --chmod=0444 /usr/local/share/veyra/source-inputs.json /usr/local/share/veyra/source-inputs.json
 # Fail the image build if the copied native binding cannot load on the runtime
 # libc. This protects the API from a delayed better-sqlite3 startup failure.
 RUN node -e 'require("better-sqlite3")'
