+FROM node:22-bookworm-slim@sha256:9f0dde62d10e7ff7a310ecaebd66225f6b46c17e6cb778449a77b05d3541bea2 AS runtime-base
+COPY --chown=root:root --chmod=0444 tools/veyra-release/reproducible-linux.mjs /usr/local/libexec/veyra/reproducible-linux.mjs
+COPY --chown=root:root --chmod=0444 tools/veyra-release/linux-build.lock.json /usr/local/share/veyra/linux-build.lock.json
+RUN VEYRA_IMAGE_BUILD_CONTEXT=1 node /usr/local/libexec/veyra/reproducible-linux.mjs configure /usr/local/share/veyra/linux-build.lock.json

 ARG OPENCODE_VERSION=2.0.11
 ARG OPENCODE_SHA256=59e917d7c0704e84f050619973e28374269b1c814548f8c9ae7942f69d69ee13
 ARG CLOUDFLARED_VERSION=2026.10.4
 ARG CLOUDFLARED_SHA256=ae5e8add7884b0531d66bbca4570d1de491ff6da51e4ebe7eb160cdf241d9e42
-RUN apt-get update && apt-get install -y --no-install-recommends \
+RUN export VEYRA_IMAGE_BUILD_CONTEXT=1; apt-get update --error-on=any && \
+    node /usr/local/libexec/veyra/reproducible-linux.mjs verify-indexes /usr/local/share/veyra/linux-build.lock.json && \
+    apt-get install -y --no-install-recommends \
     supervisor nginx curl ca-certificates tzdata git acl libcap2-bin libssl3 openssl && \
     rm -rf /var/lib/apt/lists/*
 # Patch the image's standalone npm tooling without changing application locks.
-RUN NPM_CONFIG_CACHE=/tmp/ingenium-runtime-npm-cache NPM_CONFIG_LOGS_DIR=/tmp/ingenium-runtime-npm-logs \
+RUN export NPM_CONFIG_CACHE=/tmp/ingenium-runtime-npm-cache NPM_CONFIG_LOGS_DIR=/tmp/ingenium-runtime-npm-logs APPDATA=/tmp/ingenium-runtime-build-appdata LOCALAPPDATA=/tmp/ingenium-runtime-build-localappdata; curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/veyra-npm.tgz 'https://registry.npmjs.org/npm/-/npm-12.2.1.tgz' && \
+    VEYRA_IMAGE_BUILD_CONTEXT=1 node /usr/local/libexec/veyra/reproducible-linux.mjs verify-npm /usr/local/share/veyra/linux-build.lock.json /tmp/veyra-npm.tgz && \
+    NPM_CONFIG_CACHE=/tmp/ingenium-runtime-npm-cache NPM_CONFIG_LOGS_DIR=/tmp/ingenium-runtime-npm-logs \
     APPDATA=/tmp/ingenium-runtime-build-appdata LOCALAPPDATA=/tmp/ingenium-runtime-build-localappdata \
-    npm install --global --ignore-scripts npm@12.2.1 && \
+    npm install --offline --global --ignore-scripts --no-audit --no-fund /tmp/veyra-npm.tgz && \
     test "$(npm --version)" = "12.2.1" && \
-    rm -rf /tmp/ingenium-runtime-npm-cache /tmp/ingenium-runtime-npm-logs /tmp/ingenium-runtime-build-appdata /tmp/ingenium-runtime-build-localappdata
+    rm -rf /tmp/ingenium-runtime-npm-cache /tmp/ingenium-runtime-npm-logs /tmp/ingenium-runtime-build-appdata /tmp/ingenium-runtime-build-localappdata /tmp/veyra-npm.tgz
 RUN curl -fsSL -o /tmp/opencode.tar.gz "https://opencode.ai/files/bin/${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" && \
     echo "${OPENCODE_SHA256}  /tmp/opencode.tar.gz" | sha256sum -c - && \
     tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin/ opencode && \
@@ -180,12 +197,17 @@
 WORKDIR /app

 COPY --from=builder --chown=root:root /app/node_modules ./node_modules
