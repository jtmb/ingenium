+++ b/services/ingenium-api/lib/native-hosted-connection-owner.ts
@@ -0,0 +1,69 @@
+/** Root composition proposal for Worker5 VerifiedNativeContextOwner.
+ * Actual paired credential custody MUST exist; this does not mint/load it from request metadata.
+ * Preflight awaits real paired TLS reads before the synchronous Core transaction callback.
+ */
+import type {Request,Response,NextFunction} from "express";
+import {getDb,HostedRefusal,payloadHash,type Row,type VerifiedNative} from "ingenium-core";
+import type {VerifiedNativeContextOwner} from "./routes/native-customize-context.js";
+import {contextProof,originalProof,type NativePairOriginal,type NativeOwner} from "./paired-native-proof.js";
+import type {createPairedNativeReader} from "./paired-native-reader.js";
+type Reader=ReturnType<typeof createPairedNativeReader>;
+export interface OriginalNativeConnectionCustody {
+ /** Root's existing private enrolled account/connection owner supplies the real paired Native credential.
+  * No URL/token/actor/project/body can construct custody. The reader itself uses only fixed Native proof paths.
+  */
+ withOriginal<T>(actorId:string,installationId:string,enrollmentRequestId:string,work:(reader:Reader)=>Promise<T>):Promise<T>;
+}
+type Frame={actorId:string;installationId:string;requestId:string;proof:NativeOwner;original:NativePairOriginal;startedAt:number;operationId?:string;payloadHash?:string};
+export function createVerifiedNativeContextOwner(custody:OriginalNativeConnectionCustody){
+ const frames=new WeakMap<Request,Frame>();
+ const currentUser=(req:Request)=>{const p=req.principal;if(p?.type!=="user"||!p.session)throw new HostedRefusal("BROWSER_SESSION_REQUIRED",401);return p;};
+ function checked(req:Request,actorId:string):Frame{
+  const p=currentUser(req),frame=frames.get(req);
+  if(!frame||frame.actorId!==actorId||p.id!==actorId||performance.now()-frame.startedAt>2000)throw new HostedRefusal("NATIVE_ATTESTATION_UNAVAILABLE",503);
+  return frame;
+ }
+ const owner:VerifiedNativeContextOwner={
+  enrollment(req,requestId,actorId):VerifiedNative{
+   const frame=checked(req,actorId);if(frame.requestId!==requestId)throw new HostedRefusal("NATIVE_ATTESTATION_REFUSED",503);
+   return {actorId,nativeLibraryId:frame.proof.library_id,nativeServiceInstanceId:frame.proof.service_instance_id,
+    nativeProjectId:frame.proof.project?.id as string??null,nativeProjectRevision:frame.proof.project?.revision as number??null};
+  },
+  current(req,grant:Row,_recovery:boolean,actorId){
+   const frame=checked(req,actorId),n=frame.proof;
+   if(grant.enrollment_request_id!==frame.requestId||grant.installation_id!==frame.installationId||grant.owner_user_id!==actorId||
+    grant.native_library_id!==n.library_id||grant.native_service_instance_id!==n.service_instance_id||
+    grant.native_project_id!==(n.project?.id??null)||grant.native_project_revision!==(n.project?.revision??null))throw new HostedRefusal("NATIVE_ATTESTATION_REFUSED",503);
+   if(req.method==="POST"&&req.path.endsWith("/effects")&&(!frame.operationId||frame.operationId!==req.body?.original?.id||frame.payloadHash!==payloadHash(req.body.original)))throw new HostedRefusal("NATIVE_ORIGINAL_NOT_DISPATCHED",409);
+  }
+ };
+ async function preflight(req:Request,_res:Response,next:NextFunction){
+  try{
+   if(req.method==="GET"&&req.path.endsWith("/identity")){next();return;}
+   const p=currentUser(req),installation=getDb().prepare("SELECT instance_id FROM veyra_installation_identity WHERE singleton=1").get() as {instance_id:string}|undefined;
+   if(!installation)throw new HostedRefusal("HOST_IDENTITY_UNAVAILABLE",503);
+   let requestId:string;
+   if(req.method==="POST"&&req.path.endsWith("/enrollments"))requestId=req.body?.enrollmentRequestId;
+   else{
+    const grantId=req.params.grantId??req.body?.grantId??req.body?.original?.binding?.grantId??req.query.grantId;
+    if(typeof grantId!=="string")throw new HostedRefusal("INVALID_GRANT",422);
+    const row=getDb().prepare("SELECT enrollment_request_id FROM native_hosted_governance_grants WHERE id=? AND owner_user_id=? AND installation_id=? AND revoked_at IS NULL").get(grantId,p.id,installation.instance_id) as {enrollment_request_id:string}|undefined;
+    if(!row)throw new HostedRefusal("NOT_FOUND",404);requestId=row.enrollment_request_id;
+   }
+   if(typeof requestId!=="string"||!/^[A-Za-z0-9][A-Za-z0-9:_-]{0,255}$/.test(requestId))throw new HostedRefusal("INVALID_ENROLLMENT",422);
+   const startedAt=performance.now();
+   const frame=await custody.withOriginal(p.id,installation.instance_id,requestId,async reader=>{
+    if(reader.original.actorId!==p.id||reader.original.installationId!==installation.instance_id||reader.original.enrollmentRequestId!==requestId)throw new HostedRefusal("NATIVE_ATTESTATION_REFUSED",503);
+    if(req.method==="POST"&&req.path.endsWith("/effects")){
+     const operationId=req.body?.original?.id,hash=payloadHash(req.body?.original);
+     if(typeof operationId!=="string")throw new HostedRefusal("INVALID_OPERATION_ID",422);
+     const proof=originalProof(await reader.readOriginal(operationId,hash),reader.original,operationId,hash);
+     return {actorId:p.id,installationId:installation.instance_id,requestId,proof,original:reader.original,startedAt,operationId,payloadHash:hash};
+    }
+    return {actorId:p.id,installationId:installation.instance_id,requestId,proof:contextProof(await reader.readContext(),reader.original),original:reader.original,startedAt};
+   });
+   frames.set(req,frame);next();
+  }catch(e){next(e instanceof HostedRefusal?e:new HostedRefusal("NATIVE_ATTESTATION_UNAVAILABLE",503));}
+ }
+ return {owner,preflight};
+}
diff --git a/services/ingenium-api/lib/paired-native-proof.ts b/services/ingenium-api/lib/paired-native-proof.ts
new file mode 100644
--- /dev/null
+++ b/services/ingenium-api/lib/paired-native-proof.ts
@@ -0,0 +1,24 @@
+/** Decodes actual paired Native proofs against original PRIVATE custody; no body-derived identities. */
+export type NativeOwner={library_id:string;service_instance_id:string;project:Record<string,unknown>|null};
+export type NativePairOriginal={actorId:string;installationId:string;enrollmentRequestId:string;authorityId:string;grantId:string;grantRevision:number;nativeOwner:NativeOwner};
+type Json=Record<string,unknown>;
+const obj=(v:unknown):v is Json=>!!v&&typeof v==="object"&&!Array.isArray(v);
+const same=(a:unknown,b:unknown)=>stable(a)===stable(b);
+function stable(v:unknown):string{return JSON.stringify(v,(_k,value)=>obj(value)?Object.fromEntries(Object.keys(value).sort().map(k=>[k,value[k]])):value);}
+function denied():never{throw new Error("NATIVE_ORIGINAL_PROOF_REFUSED");}
+export function contextProof(value:unknown,original:NativePairOriginal):NativeOwner{
+ if(!obj(value)||Object.keys(value).sort().join(",")!=="actor_id,enrollment_request_id,grant,installation_id,native_authority_id,native_owner,protocol"||
+ value.protocol!=="node_hosted_native_custodian_v1"||value.actor_id!==original.actorId||value.installation_id!==original.installationId||
+ value.enrollment_request_id!==original.enrollmentRequestId||value.native_authority_id!==original.authorityId||!obj(value.grant)||
+ value.grant.id!==original.grantId||value.grant.revision!==original.grantRevision||value.grant.revoked!==false||
+ !obj(value.grant.scope)||!Array.isArray(value.grant.scope.permissions)||!value.grant.scope.permissions.includes("hosted_enrollment")||
+ !same(value.native_owner,original.nativeOwner))return denied();
+ const n=original.nativeOwner;
+ if(!n.library_id||!n.service_instance_id||n.project!==null&&(!obj(n.project)||typeof n.project.id!=="string"||!Number.isSafeInteger(n.project.revision)))return denied();
+ return structuredClone(n);
+}
+export function originalProof(value:unknown,original:NativePairOriginal,operationId:string,payloadHash:string):NativeOwner{
+ if(!obj(value)||Object.keys(value).sort().join(",")!=="context,dispatch_claimed,operation_id,payload_hash,protocol"||
+ value.protocol!=="node_hosted_native_original_v1"||value.operation_id!==operationId||value.payload_hash!==payloadHash||value.dispatch_claimed!==true)return denied();
+ return contextProof(value.context,original);
+}
diff --git a/services/ingenium-api/lib/paired-native-reader.ts b/services/ingenium-api/lib/paired-native-reader.ts
new file mode 100644
--- /dev/null
+++ b/services/ingenium-api/lib/paired-native-reader.ts
@@ -0,0 +1,35 @@
+/** Private paired Native HTTPS client. It is never a router, proxy or renderer API. */
+import https from "node:https";
+import tls from "node:tls";
+import {createHash} from "node:crypto";
+import type {NativePairOriginal} from "./paired-native-proof.js";
+export type PairedNativeCredential=Readonly<{endpoint:string;certificatePem:string;certificateSha256:string;token:string;original:NativePairOriginal}>;
+const id=(s:string)=>/^[A-Za-z0-9][A-Za-z0-9:_-]{0,255}$/.test(s);
+export function createPairedNativeReader(credential:PairedNativeCredential){
+ const origin=new URL(credential.endpoint);
+ if(origin.protocol!=="https:"||origin.username||origin.password||origin.pathname!=="/"||origin.search||origin.hash||
+ !/^[a-f0-9]{64}$/.test(credential.certificateSha256)||!/^[a-f0-9]{64}$/.test(credential.token))throw new Error("NATIVE_CUSTODY_INVALID");
+ const original=structuredClone(credential.original),pin=credential.certificateSha256,token=credential.token,certificatePem=credential.certificatePem;
+ function read(operation:"context"|"original",operationId?:string,payloadHash?:string):Promise<unknown>{
+  if(!id(original.enrollmentRequestId)||!id(original.actorId)||!id(original.installationId)||operation==="original"&&(!operationId||!id(operationId)||!payloadHash||!/^[a-f0-9]{64}$/.test(payloadHash)))throw new Error("NATIVE_SELECTOR_INVALID");
+  const path="/remote/v1/node-hosted/enrollments/"+encodeURIComponent(original.enrollmentRequestId)+(operation==="context"?"/context":"/originals/"+encodeURIComponent(operationId!));
+  const url=new URL(path,origin);url.searchParams.set("actor_id",original.actorId);url.searchParams.set("installation_id",original.installationId);
+  if(operation==="original")url.searchParams.set("payload_hash",payloadHash!);
+  return new Promise((resolve,reject)=>{
+   let settled=false;const fail=()=>{if(!settled){settled=true;reject(new Error("NATIVE_OWNER_UNAVAILABLE"));}};
+   const request=https.request(url,{method:"GET",agent:false,ca:certificatePem,rejectUnauthorized:true,
+    checkServerIdentity:(host,certificate)=>{if(!certificate.raw||createHash("sha256").update(certificate.raw).digest("hex")!==pin)return new Error("NATIVE_PIN_REFUSED");return tls.checkServerIdentity(host,certificate);},
+    headers:{Authorization:"Bearer "+token,Accept:"application/json","Cache-Control":"no-store"}},response=>{
+     const parts:Buffer[]=[];let count=0;
+     if(response.statusCode!==200){response.destroy();request.destroy();fail();return;}
+     response.on("data",part=>{const bytes=Buffer.from(part);count+=bytes.length;if(count>128*1024){response.destroy();request.destroy();fail();}else parts.push(bytes);});
+     response.on("error",fail);response.on("aborted",fail);
+     response.on("end",()=>{if(settled)return;try{const value=JSON.parse(Buffer.concat(parts).toString("utf8"));settled=true;resolve(value);}catch{fail();}});
+    });
+   // Absolute timeout includes DNS/TLS/body; no redirects, proxy, retry or fallback.
+   const timer=setTimeout(()=>{request.destroy();fail();},2000);timer.unref();
+   request.on("close",()=>clearTimeout(timer));request.on("error",fail);request.end();
+  });
+ }
+ return Object.freeze({original,readContext:()=>read("context"),readOriginal:(operationId:string,payloadHash:string)=>read("original",operationId,payloadHash)});
+}
