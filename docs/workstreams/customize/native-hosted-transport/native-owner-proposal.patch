--- /dev/null
+++ b/apps/service/src/routes/remote_control/hosted_governance.rs
@@ -0,0 +1,219 @@
+//! Typed local Native owner for NodeHosted governance. Not installed into the generic remote proxy.
+use super::*;
+use serde::Serialize;
+use veyra_adapters::{account_vault::AccountVault,access_profiles::AccessProfiles,utility_operations,remote_control::hosted::{self,contracts::*}};
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct Context {library_id:String,service_instance_id:String,project:Option<veyra_contracts::Project>}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct ReadRequest {binding:Binding,command:Read}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct ReserveRequest {binding:Binding,command:Write}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct OriginalRequest {binding:Binding,original:Original}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct OwnerRequest {binding:Binding}
+pub(super) fn router()->Router<Arc<ServiceState>>{
+ Router::new().route("/context",post(context)).route("/read",post(read)).route("/reserve",post(reserve))
+  .route("/send",post(send)).route("/inspect",post(inspect)).route("/pending",post(pending))
+  .layer(axum::extract::DefaultBodyLimit::max(2_100_000))
+  .layer(axum::middleware::map_response(|mut r:Response|async move{r.headers_mut().insert(axum::http::header::CACHE_CONTROL,axum::http::HeaderValue::from_static("no-store"));r}))
+}
+fn value<T:Serialize>(v:T)->Result<Value,Error>{serde_json::to_value(v).map_err(|_|Error::Unavailable)}
+fn library(state:&ServiceState)->Result<String,Error>{utility_operations::Store::open(&state.state_directory).and_then(|s|s.library_id()).map_err(|_|Error::Unavailable)}
+fn native_owner(state:&ServiceState,library_id:&str,service_instance:&str,project_id:Option<&str>,revision:Option<u32>)->Result<NativeOwner,Error>{
+ if library(state)?!=library_id||state.instance_id!=service_instance{return Err(Error::Conflict);}
+ let projects=state.projects.lock().map_err(|_|Error::Unavailable)?;
+ let project=project_id.map(|id|projects.as_ref().ok_or(Error::Unavailable)?.get(id).map_err(|_|Error::Conflict)).transpose()?;
+ if project.as_ref().is_some_and(|p|p.archived||Some(p.revision)!=revision)||project.is_none()&&revision.is_some(){return Err(Error::Conflict);}
+ Ok(NativeOwner{library_id:library_id.into(),service_instance_id:service_instance.into(),project})
+}
+fn current(state:&ServiceState,id:&str,b:&Binding)->Result<(hosted::SessionConnection,Identity),Error>{
+ if b.connection_id!=id{return Err(Error::Forbidden);}
+ let connection=state.remote_control.store.hosted(id)?;
+ let owner=native_owner(state,&b.native_library_id,&b.native_service_instance_id,b.native_project_id.as_deref(),b.native_project_revision)?;
+ if json!(owner.project)!=json!(connection.enrollment().native_owner.project){return Err(Error::Conflict);}
+ let actual=connection.identity(&AccountVault::new(&state.state_directory),&owner)?;
+ if actual.binding!=*b{return Err(Error::Conflict);}
+ state.remote_control.store.require_hosted(&connection)?;
+ Ok((connection,actual))
+}
+/// Reuse the existing tracked RemoteControl worker custody before any journal/network work.
+/// The command mutex covers forget/revoke/admin races; blocking work outlives its HTTP waiter.
+async fn retained(state:Arc<ServiceState>,work:impl FnOnce(Arc<ServiceState>)->Result<Value,Error>+Send+'static)->Response{
+ let control=state.remote_control.clone();let worker=state.clone();let(tx,rx)=tokio::sync::oneshot::channel();
+ if let Err(e)=control.retain(format!("hosted:{}",uuid::Uuid::new_v4()),async move{
+  // Existing /v1/remote-control has no agent_admission layer. Acquire the shared serial FIRST,
+  // matching account/access-profile admission order; do not wrap this router in agent_admission.
+  let project_guard=worker.serial.clone().lock_owned().await;
+  let guard=worker.remote_control.commands.clone().lock_owned().await;
+  let result=blocking(move||{let _guard=guard;let _project_guard=project_guard;if worker.draining.load(Ordering::SeqCst){return Err(Error::Unavailable);}work(worker)}).await;
+  let _=tx.send(result);
+ }){return problem(e);}
+ match rx.await{Ok(Ok(v))=>Json(v).into_response(),Ok(Err(e))=>problem(e),Err(_)=>problem(Error::Unavailable)}
+}
+async fn context(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<Context>)->Response{
+ retained(state,move|state|{
+  let owner=native_owner(&state,&input.library_id,&input.service_instance_id,input.project.as_ref().map(|p|p.id.as_str()),input.project.as_ref().map(|p|p.revision))?;
+  if json!(input.project)!=json!(owner.project){return Err(Error::Conflict);}
+  let connection=state.remote_control.store.hosted(&id)?;
+  if json!(owner.project)!=json!(connection.enrollment().native_owner.project){return Err(Error::Conflict);}
+  let identity=connection.identity(&AccountVault::new(&state.state_directory),&owner)?;
+  let capabilities=connection.available(&AccessProfiles::new(&state.state_directory),&identity)?;
+  state.remote_control.store.require_hosted(&connection)?;
+  Ok(json!({"protocol":"node_hosted_governance_v1","binding":identity.binding,"capabilities":capabilities}))
+ }).await
+}
+async fn read(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<ReadRequest>)->Response{
+ retained(state,move|state|{
+  let(connection,identity)=current(&state,&id,&input.binding)?;
+  let actual=connection.read(&AccountVault::new(&state.state_directory),&AccessProfiles::new(&state.state_directory),&identity,&input.command)?;
+  state.remote_control.store.require_hosted(&connection)?;
+  Ok(json!({"binding":identity.binding,"value":actual}))
+ }).await
+}
+fn index(state:&ServiceState,connection:&hosted::SessionConnection,identity:&Identity,journal:&utility_operations::Store)->Result<Vec<hosted::Retained>,Error>{
+ let key=hosted::recovery_key(&identity.binding);
+ let rows=journal.hosted_pending(&key).map_err(|_|Error::Unavailable)?.into_iter().map(|v|serde_json::from_value(v).map_err(|_|Error::Unavailable)).collect::<Result<Vec<hosted::Retained>,Error>>()?;
+ let remote=connection.pending(&AccountVault::new(&state.state_directory),&AccessProfiles::new(&state.state_directory),identity)?;
+ for receipt in remote{
+  if !rows.iter().any(|r|r.original.id==receipt.operation_id&&hosted::payload_hash(&r.original).ok().as_deref()==Some(receipt.payload_hash.as_str())){return Err(Error::Conflict);}
+ }
+ Ok(rows)
+}
+async fn reserve(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<ReserveRequest>)->Response{
+ retained(state,move|state|{
+  let(connection,identity)=current(&state,&id,&input.binding)?;
+  if !input.command.validate()||!connection.available(&AccessProfiles::new(&state.state_directory),&identity)?.contains(&input.command.capability()){return Err(Error::Forbidden);}
+  let mut journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+  if !index(&state,&connection,&identity,&journal)?.is_empty(){return Err(Error::Conflict);}
+  let original=Original{id:uuid::Uuid::new_v4().to_string(),binding:identity.binding,command:input.command};
+  let record=hosted::Retained{original:original.clone(),private_owner:connection.enrollment().clone(),connection:connection.view().clone()};
+  // Validate canonical original size before creating a durable barrier.
+  hosted::payload_hash(&original)?;
+  journal.hosted_reserve(&original.id,&hosted::recovery_key(&original.binding),&value(record)?).map_err(|_|Error::Conflict)
+ }).await
+}
+fn retained_original(state:&ServiceState,input:&OriginalRequest)->Result<(utility_operations::Store,Value,hosted::Retained,Option<Receipt>),Error>{
+ if hosted::recovery_key(&input.binding)!=hosted::recovery_key(&input.original.binding){return Err(Error::Forbidden);}
+ let journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+ let row=journal.hosted_record(&input.original.id,&hosted::recovery_key(&input.binding)).map_err(|_|Error::Unavailable)?.ok_or(Error::NotFound)?;
+ let record:hosted::Retained=serde_json::from_value(row["record"].clone()).map_err(|_|Error::Unavailable)?;
+ if record.original!=input.original{return Err(Error::Conflict);}
+ let receipt=if row["result"].is_null(){None}else{Some(serde_json::from_value(row["result"].clone()).map_err(|_|Error::Unavailable)?)};
+ Ok((journal,row,record,receipt))
+}
+fn inspect_exact(state:&ServiceState,connection:&hosted::SessionConnection,identity:&Identity,input:&OriginalRequest)->Result<Value,Error>{
+ let(mut journal,row,record,terminal)=retained_original(state,input)?;
+ let key=hosted::recovery_key(&input.binding);
+ if let Some(receipt)=terminal{
+  // Recheck original access at its actual Node owner, including current source permission.
+  let actual=connection.inspect(&AccountVault::new(&state.state_directory),&AccessProfiles::new(&state.state_directory),identity,&input.original)?;
+  if actual.outcome==Outcome::Unknown{return value(receipt);}
+  if actual.outcome!=receipt.outcome{return Err(Error::Conflict);}return value(receipt);
+ }
+ if row["started"]==false{
+  let refused=Receipt{original:input.original.clone(),outcome:Outcome::Refused,value:None,error:Some(PublicError{status:None,code:"native_original_never_dispatched".into(),message:"The Native original owner atomically closed this unsent original; no hosted request was replayed.".into()})};
+  if journal.hosted_refuse_unstarted(&input.original.id,&key,&value(&record)?,&value(&refused)?).map_err(|_|Error::Unavailable)?{return value(refused);}
+ }
+ let receipt=connection.inspect(&AccountVault::new(&state.state_directory),&AccessProfiles::new(&state.state_directory),identity,&input.original).unwrap_or_else(|_|hosted::unknown(&input.original));
+ if receipt.outcome!=Outcome::Unknown{journal.finish(&input.original.id,&value(&receipt)?).map_err(|_|Error::Unavailable)?;}
+ value(receipt)
+}
+async fn send(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<OriginalRequest>)->Response{
+ retained(state,move|state|{
+  let(connection,identity)=current(&state,&id,&input.binding)?;
+  let(mut journal,_row,record,terminal)=retained_original(&state,&input)?;
+  if terminal.is_some(){return inspect_exact(&state,&connection,&identity,&input);}
+  if input.original.binding!=identity.binding{return Err(Error::Conflict);}
+  if !journal.hosted_claim(&input.original.id,&hosted::recovery_key(&input.binding),&value(&record)?).map_err(|_|Error::Unavailable)?{return inspect_exact(&state,&connection,&identity,&input);}
+  let receipt=connection.send(&AccountVault::new(&state.state_directory),&AccessProfiles::new(&state.state_directory),&identity,&input.original).unwrap_or_else(|_|hosted::unknown(&input.original));
+  // Network/decoder/checkpoint ambiguity stays NULL/pending; it is never a refusal or new dispatch.
+  if receipt.outcome!=Outcome::Unknown{journal.finish(&input.original.id,&value(&receipt)?).map_err(|_|Error::Unavailable)?;}
+  value(receipt)
+ }).await
+}
+async fn inspect(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<OriginalRequest>)->Response{
+ retained(state,move|state|{let(connection,identity)=current(&state,&id,&input.binding)?;inspect_exact(&state,&connection,&identity,&input)}).await
+}
+async fn pending(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,Json(input):Json<OwnerRequest>)->Response{
+ retained(state,move|state|{
+  let(connection,identity)=current(&state,&id,&input.binding)?;
+  let journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+  value(index(&state,&connection,&identity,&journal)?.into_iter().map(|r|r.original).collect::<Vec<_>>())
+ }).await
+}
+
+// Closed paired TLS reads for Root's ACTUAL private Node Native-client owner.
+// No local service credential or broad proxy crosses this boundary.
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct CustodianQuery{actor_id:String,installation_id:String}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct OriginalProofQuery{actor_id:String,installation_id:String,payload_hash:String}
+pub(super) fn paired_router()->Router<Arc<ServiceState>>{
+ Router::new().route("/remote/v1/node-hosted/enrollments/{id}/context",get(paired_context))
+  .route("/remote/v1/node-hosted/enrollments/{id}/originals/{operation}",get(paired_original))
+  .layer(axum::middleware::map_response(|mut r:Response|async move{r.headers_mut().insert(axum::http::header::CACHE_CONTROL,axum::http::HeaderValue::from_static("no-store"));r}))
+}
+async fn paired_context(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,axum::extract::Query(q):axum::extract::Query<CustodianQuery>,headers:HeaderMap)->Response{
+ let(grant,_)=match proxy::authentication(&state,&headers,false).await{Ok(v)=>v,Err(e)=>return problem(e)};
+ match blocking(move||{
+  let store=&state.remote_control.store;
+  let c=store.node_custodian(&grant,&id,&q.actor_id,&q.installation_id)?;
+  let owner=native_owner(&state,&c.native_owner.library_id,&c.native_owner.service_instance_id,c.native_owner.project.as_ref().map(|p|p.id.as_str()),c.native_owner.project.as_ref().map(|p|p.revision))?;
+  value(store.context_proof(&grant,&c,&owner)?)
+ }).await{Ok(v)=>Json(v).into_response(),Err(e)=>problem(e)}
+}
+async fn paired_original(State(state):State<Arc<ServiceState>>,Path((id,operation)):Path<(String,String)>,axum::extract::Query(q):axum::extract::Query<OriginalProofQuery>,headers:HeaderMap)->Response{
+ let(grant,_)=match proxy::authentication(&state,&headers,false).await{Ok(v)=>v,Err(e)=>return problem(e)};
+ match blocking(move||{
+  let store=&state.remote_control.store;let c=store.node_custodian(&grant,&id,&q.actor_id,&q.installation_id)?;
+  let owner=native_owner(&state,&c.native_owner.library_id,&c.native_owner.service_instance_id,c.native_owner.project.as_ref().map(|p|p.id.as_str()),c.native_owner.project.as_ref().map(|p|p.revision))?;
+  let proof=store.context_proof(&grant,&c,&owner)?;
+  let journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+  let stored=journal.original(&operation,"hosted_governance").map_err(|_|Error::Unavailable)?.ok_or(Error::NotFound)?;
+  let record:hosted::Retained=serde_json::from_value(stored["original"].clone()).map_err(|_|Error::Unavailable)?;
+  if record.original.binding.actor_id!=c.actor_id||record.original.binding.installation_id!=c.installation_id||
+    record.private_owner.enrollment_request_id!=id||hosted::payload_hash(&record.original)?!=q.payload_hash{return Err(Error::Forbidden);}
+  let claim=journal.hosted_record(&operation,&hosted::recovery_key(&record.original.binding)).map_err(|_|Error::Unavailable)?.ok_or(Error::NotFound)?;
+  if claim["started"]!=true{return Err(Error::Forbidden);}
+  Ok(json!({"protocol":"node_hosted_native_original_v1","context":proof,"operation_id":operation,"payload_hash":q.payload_hash,"dispatch_claimed":true}))
+ }).await{Ok(v)=>Json(v).into_response(),Err(e)=>problem(e)}
+}
+
+// Existing native account credential-file UI supplies metadata only; no email/password/code/cookie fields.
+pub(super) fn account_router()->Router<Arc<ServiceState>>{
+ Router::new().route("/connections",get(hosted_connections)).route("/account-commands",post(account_command)).route("/account-originals/{id}",get(account_original))
+  .layer(axum::extract::DefaultBodyLimit::max(128*1024))
+}
+async fn account_command(State(state):State<Arc<ServiceState>>,Json(input):Json<hosted::AccountCommand>)->Response{
+ retained(state,move|state|{
+  let actual=native_owner(&state,&input.native_owner.library_id,&input.native_owner.service_instance_id,input.native_owner.project.as_ref().map(|p|p.id.as_str()),input.native_owner.project.as_ref().map(|p|p.revision))?;
+  if json!(actual)!=json!(input.native_owner){return Err(Error::Conflict);}
+  let mut journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+  let original=json!({"protocol":"node_hosted_account_v1","command":input});
+  if let Some(row)=journal.original(&input.operation_id,"remote_admin").map_err(|_|Error::Unavailable)?{
+   return if row["original"]==original{Ok(row)}else{Err(Error::Conflict)};
+  }
+  journal.begin(&input.operation_id,"remote_admin",&original).map_err(|_|Error::Conflict)?;
+  let result=match hosted::sign_in(&state.state_directory,&input){
+   Ok(status)=>json!({"state":"completed","value":status}),
+   Err(_)=>json!({"state":"unconfirmed","code":"node_hosted_account_unconfirmed","message":"The consumed original remains retained; do not replay login or MFA."})
+  };
+  journal.finish(&input.operation_id,&result).map_err(|_|Error::Unavailable)?;
+  journal.original(&input.operation_id,"remote_admin").map_err(|_|Error::Unavailable)?.ok_or(Error::Unavailable)
+ }).await
+}
+#[derive(Deserialize)]#[serde(deny_unknown_fields)]
+struct AccountOriginalQuery{library_id:String}
+async fn account_original(State(state):State<Arc<ServiceState>>,Path(id):Path<String>,axum::extract::Query(query):axum::extract::Query<AccountOriginalQuery>)->Response{
+ match blocking(move||{
+  if library(&state)?!=query.library_id{return Err(Error::Forbidden);}
+  let journal=utility_operations::Store::open(&state.state_directory).map_err(|_|Error::Unavailable)?;
+  let row=journal.original(&id,"remote_admin").map_err(|_|Error::Unavailable)?.ok_or(Error::NotFound)?;
+  if row["original"]["protocol"]!="node_hosted_account_v1"||row["original"]["command"]["native_owner"]["library_id"]!=query.library_id{return Err(Error::Forbidden);}Ok(row)
+ }).await{Ok(value)=>Json(value).into_response(),Err(e)=>problem(e)}
+}
+
+async fn hosted_connections(State(state):State<Arc<ServiceState>>)->Response{
+ match blocking(move||state.remote_control.store.hosted_connections()).await{Ok(rows)=>Json(json!({"connections":rows})).into_response(),Err(e)=>problem(e)}
+}
diff --git a/apps/web/src/platform/hostedGovernance.ts b/apps/web/src/platform/hostedGovernance.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/platform/hostedGovernance.ts
@@ -0,0 +1,61 @@
+import type {Project} from "@veyra/contracts";
+import type {Gateway} from "./types";
+import type {Binding,BoundGovernanceTransport,Operation,OperationReceipt,ReadCommand,WriteCommand,WriteOriginal} from "../features/customize/hosted-governance/contracts";
+
+export type NativeHostedSelection=Readonly<{libraryId:string;serviceInstanceId:string;connectionId:string;project:Project|null}>;
+const fields=["authorityId","connectionId","grantId","grantRevision","epoch","nativeLibraryId","nativeServiceInstanceId","hostedServiceInstanceId","nativeProjectId","nativeProjectRevision","actorId","installationId","hostedProjectId","apiProject","visibility"];
+const operations:readonly Operation[]=["catalog","skill","archived","proposal-counts","proposal-page","proposal","synthesis-status","synthesis-models","pipeline","create","save","archive","restore","enable","disable","approve","reject","rollback","submit","synthesis-run"];
+const record=(v:unknown):v is Record<string,unknown>=>!!v&&typeof v==="object"&&!Array.isArray(v);
+const nonempty=(v:unknown):v is string=>typeof v==="string"&&!!v.trim()&&v.length<=4096&&!/[\u0000-\u001f]/.test(v);
+function binding(value:unknown):Binding{
+ if(!record(value)||Object.keys(value).length!==fields.length||Object.keys(value).some(k=>!fields.includes(k)))throw new Error("Invalid hosted owner context");
+ for(const key of fields.filter(k=>!["nativeProjectId","nativeProjectRevision","grantRevision","visibility"].includes(k)))if(!nonempty(value[key]))throw new Error("Invalid hosted owner identity");
+ if(!Number.isSafeInteger(value.grantRevision)||(value.grantRevision as number)<1||!["project","system"].includes(value.visibility as string)||
+ !(value.nativeProjectId===null&&value.nativeProjectRevision===null||nonempty(value.nativeProjectId)&&Number.isSafeInteger(value.nativeProjectRevision)&&(value.nativeProjectRevision as number)>=0))throw new Error("Invalid hosted grant/project context");
+ return Object.freeze(structuredClone(value)) as Binding;
+}
+const canonical=(value:unknown):string=>JSON.stringify(value,(_key,v)=>record(v)?Object.fromEntries(Object.keys(v).sort().map(k=>[k,v[k]])):v);
+const key=(value:Binding)=>JSON.stringify(fields.map(k=>value[k as keyof Binding]));
+const selectionKey=(s:NativeHostedSelection)=>JSON.stringify([s.libraryId,s.serviceInstanceId,s.connectionId,s.project]);
+const recoveryKey=(b:Binding)=>JSON.stringify([b.nativeLibraryId,b.nativeServiceInstanceId,b.hostedServiceInstanceId,b.authorityId,b.connectionId,b.actorId,b.installationId,b.nativeProjectId,b.hostedProjectId,b.visibility]);
+function original(value:unknown):WriteOriginal{
+ if(!record(value)||Object.keys(value).length!==3||Object.keys(value).some(k=>!["id","binding","command"].includes(k))||!nonempty(value.id)||!record(value.command)||!operations.includes(value.command.op as Operation))throw new Error("Invalid retained hosted original");
+ return {id:value.id,binding:binding(value.binding),command:structuredClone(value.command) as WriteCommand};
+}
+/** Concrete Native authenticated gateway consumer. No renderer endpoint, token, cookie or fetch. */
+export async function connectHostedGovernance(gateway:Pick<Gateway,"workbench">,selection:NativeHostedSelection,
+ currentSelection:()=>NativeHostedSelection|null):Promise<BoundGovernanceTransport>{
+ if(!gateway.workbench||![selection.libraryId,selection.serviceInstanceId,selection.connectionId].every(nonempty))throw new Error("The existing native connection owner is unavailable");
+ const initial=structuredClone(selection),selected=selectionKey(initial),request=gateway.workbench;
+ const isSelected=()=>{try{const actual=currentSelection();return !!actual&&selectionKey(actual)===selected;}catch{return false;}};
+ const check=()=>{if(!isSelected())throw new Error("Native connection or project changed");};
+ const path="/v1/remote-control/connections/"+encodeURIComponent(initial.connectionId)+"/hosted-governance";
+ check();
+ const response=await request("POST",path+"/context",{library_id:initial.libraryId,service_instance_id:initial.serviceInstanceId,project:initial.project},isSelected);
+ check();
+ if(!record(response)||Object.keys(response).some(k=>!["binding","capabilities","protocol"].includes(k))||response.protocol!=="node_hosted_governance_v1"||!Array.isArray(response.capabilities)||
+ response.capabilities.some(v=>!operations.includes(v as Operation))||new Set(response.capabilities).size!==response.capabilities.length)throw new Error("The saved connection has no validated hosted capability");
+ const b=binding(response.binding),owner=key(b),capabilities=Object.freeze([...response.capabilities]) as readonly Operation[];
+ if(b.nativeLibraryId!==initial.libraryId||b.nativeServiceInstanceId!==initial.serviceInstanceId||b.connectionId!==initial.connectionId||
+ b.nativeProjectId!==(initial.project?.id??null)||b.nativeProjectRevision!==(initial.project?.revision??null))throw new Error("Hosted context does not belong to this exact native owner");
+ const current=()=>isSelected()&&key(b)===owner;
+ async function call(operation:string,body:unknown):Promise<unknown>{check();const value=await request("POST",path+"/"+operation,body,current);check();return value;}
+ function samePublicOriginal(value:unknown,expected:WriteOriginal):WriteOriginal{
+   const actual=original(value);
+   if(canonical(actual)!==canonical(expected))throw new Error("Hosted original changed");
+   return actual;
+ }
+ async function inspectOriginal(o:WriteOriginal):Promise<OperationReceipt>{
+   if(recoveryKey(binding(o.binding))!==recoveryKey(b))throw new Error("Foreign hosted original");
+   const value=await call("inspect",{binding:b,original:o});
+   if(!record(value)||!["succeeded","refused","unknown"].includes(value.outcome as string))throw new Error("Invalid original receipt");
+   return {...value,original:samePublicOriginal(value.original,o)} as OperationReceipt;
+ }
+ return {binding:b,capabilities,current,
+   async read(command:ReadCommand,currentBinding:Binding){if(key(currentBinding)!==owner)throw new Error("Stale hosted read owner");const value=await call("read",{binding:b,command});if(!record(value)||key(binding(value.binding))!==owner||!Object.hasOwn(value,"value"))throw new Error("Invalid original read envelope");return {binding:b,value:value.value};},
+   async reserve(command:WriteCommand,currentBinding:Binding){if(key(currentBinding)!==owner)throw new Error("Stale hosted reserve owner");const value=original(await call("reserve",{binding:b,command}));if(key(value.binding)!==owner||canonical(value.command)!==canonical(command))throw new Error("Reservation differs from the requested original");return value;},
+   async send(o:WriteOriginal){if(key(binding(o.binding))!==owner)throw new Error("Stale hosted dispatch owner");const value=await call("send",{binding:b,original:o});if(!record(value)||!["succeeded","refused","unknown"].includes(value.outcome as string))throw new Error("Invalid original receipt");return {...value,original:samePublicOriginal(value.original,o)} as OperationReceipt;},
+   inspect:inspectOriginal,
+   async pending(currentBinding:Binding){if(key(currentBinding)!==owner)throw new Error("Stale hosted pending owner");const value=await call("pending",{binding:b});if(!Array.isArray(value))throw new Error("Original index unavailable");const rows=value.map(original);if(new Set(rows.map(o=>o.id)).size!==rows.length||rows.some(o=>recoveryKey(o.binding)!==recoveryKey(b)))throw new Error("Foreign or conflicting original index");return rows;}
+ };
+}
diff --git a/crates/adapters/src/account_vault/node_hosted.rs b/crates/adapters/src/account_vault/node_hosted.rs
new file mode 100644
--- /dev/null
+++ b/crates/adapters/src/account_vault/node_hosted.rs
@@ -0,0 +1,152 @@
+//! Actual Ingenium local-user sign-in; session/CSRF remain in the existing DPAPI vault.
+//! No secret-bearing type implements Serialize or Debug. No automatic login or refresh.
+use super::*;
+use reqwest::blocking::{Client,Response};
+const SESSION:&str="__Host-ingenium_session";
+const PREAUTH:&str="__Host-ingenium_pre_auth";
+
+const COOKIE:&str="NODE_HOSTED_SESSION_TOKEN";
+const CSRF:&str="NODE_HOSTED_CSRF_TOKEN";
+const CONNECTION:&str="NODE_HOSTED_CONNECTION_CREDENTIAL";
+const ATTEMPT:&str="NODE_HOSTED_SIGNIN_ATTEMPT_TOKEN";
+const CHALLENGE:&str="NODE_HOSTED_MFA_CHALLENGE_TOKEN";
+const ACTOR:&str="NODE_HOSTED_ACTOR_CREDENTIAL";
+
+#[derive(Clone,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AccountReview {pub account:Account,pub session_revision:Option<String>}
+#[derive(Serialize)]
+pub struct SessionStatus {pub state:&'static str,pub actor_id:Option<String>,pub review:AccountReview}
+pub(crate) struct Maintenance<'a>{pub(crate) target:Option<&'a str>,pub(crate) source:Option<&'a str>}
+pub(crate) struct Session<'a>{pub(crate) cookie:&'a str,pub(crate) csrf:&'a str,pub(crate) actor_id:&'a str,pub(crate) locks:Maintenance<'a>}
+pub(crate) struct Target<'a>{pub(crate) client:&'a Client,pub(crate) endpoint:&'a str,pub(crate) dashboard_origin:&'a str,pub(crate) connection_id:&'a str}
+fn url(target:&Target<'_>,path:&str)->Result<reqwest::Url,Error>{
+ let mut result=reqwest::Url::parse(target.endpoint).map_err(|_|Error::Invalid)?;
+ if result.scheme()!="https"||result.host_str().is_none()||result.path()!="/"||result.query().is_some()||result.fragment().is_some()||!result.username().is_empty()||result.password().is_some(){return Err(Error::Invalid);}
+ result.set_path(path);Ok(result)
+}
+fn secret(value:&Value,key:&str)->Result<String,Error>{
+ let s=value.get(key).and_then(Value::as_str).filter(|s|s.len()>=32&&s.len()<=2048&&!s.chars().any(char::is_control)).ok_or(Error::Unavailable)?;Ok(s.to_string())
+}
+fn cookie(response:&Response,name:&str)->Result<String,Error>{
+ let prefix=format!("{name}=");let mut found=None;
+ for header in response.headers().get_all(reqwest::header::SET_COOKIE){
+  let raw=header.to_str().map_err(|_|Error::Unavailable)?;
+  let first=raw.split(';').next().ok_or(Error::Unavailable)?;
+  if let Some(value)=first.strip_prefix(&prefix){
+   if found.is_some()||value.len()<32||value.len()>2048||!value.bytes().all(|b|b.is_ascii_alphanumeric()||b==b'-'||b==b'_'){return Err(Error::Unavailable);}
+   let attributes=raw.split(';').skip(1).map(|s|s.trim().to_ascii_lowercase()).collect::<Vec<_>>();
+   if !["secure","httponly","path=/","samesite=strict"].iter().all(|a|attributes.iter().any(|v|v==a))||attributes.iter().any(|a|a.starts_with("domain=")){return Err(Error::Unavailable);}
+   found=Some(format!("{name}={value}"));
+  }
+ }
+ found.ok_or(Error::Unavailable)
+}
+fn body(response:Response)->Result<Value,Error>{
+ if !response.status().is_success(){return Err(Error::Conflict);}
+ let mut bytes=Vec::new();response.take(256*1024+1).read_to_end(&mut bytes).map_err(|_|Error::Unavailable)?;
+ if bytes.len()>256*1024 {erase(&mut bytes);return Err(Error::Unavailable);}
+ let result=serde_json::from_slice::<Value>(&bytes).map_err(|_|Error::Unavailable);erase(&mut bytes);result
+}
+fn csrf(target:&Target<'_>)->Result<(String,String),Error>{
+ let response=target.client.get(url(target,"/api/v1/auth/csrf")?).send().map_err(|_|Error::Unavailable)?;
+ let cookie=cookie(&response,PREAUTH)?;let value=body(response)?;Ok((cookie,secret(&value["data"],"csrfToken")?))
+}
+fn account_matches(record:&Record,review:&AccountReview)->bool{
+ record.account.revoked_at.is_none()&&record.account.provider=="ingenium-node-hosted"&&record.account.scopes.iter().any(|s|s=="hosted-governance")&&
+ serde_json::to_value(&record.account).ok()==serde_json::to_value(&review.account).ok()&&record.credentials.get("NODE_HOSTED_SESSION_REVISION_TOKEN")==review.session_revision.as_ref()
+}
+fn review(record:&Record)->AccountReview{AccountReview{account:record.account.clone(),session_revision:record.credentials.get("NODE_HOSTED_SESSION_REVISION_TOKEN").cloned()}}
+fn status(record:&Record)->SessionStatus{
+ SessionStatus{state:if record.credentials.contains_key(COOKIE){"signed_in_unverified"}else if record.credentials.contains_key(CHALLENGE){"second_factor_required"}else{"signed_out"},
+ actor_id:record.credentials.get(ACTOR).cloned(),review:review(record)}
+}
+impl AccountVault {
+ pub fn node_hosted_status(&self,id:&str)->Result<SessionStatus,Error>{
+  let _lock=self.lock()?;let contents=self.read()?;let r=contents.accounts.iter().find(|r|r.account.id==id&&r.account.revoked_at.is_none()&&r.account.provider=="ingenium-node-hosted").ok_or(Error::NotFound)?;Ok(status(r))
+ }
+ /// Explicit consumed account command only. Password/MFA were imported through the existing native credential-file owner.
+ pub(crate) fn node_hosted_sign_in(&self,target:&Target<'_>,expected:&AccountReview,attempt:&str,second_factor:bool)->Result<SessionStatus,Error>{
+  uuid(attempt)?;let _lock=self.lock()?;let mut contents=self.read()?;
+  let r=contents.accounts.iter_mut().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  if !account_matches(r,expected)||r.credentials.contains_key(COOKIE){return Err(Error::Conflict);}
+  if r.credentials.get(CONNECTION).is_some_and(|id|id!=target.connection_id){return Err(Error::Conflict);}
+  // Commit a consumed private sign-in attempt BEFORE a request can authenticate.
+  // A lost response never causes an automatic password/MFA replay.
+  if r.credentials.get(ATTEMPT).is_some_and(|id|id==attempt){return Err(Error::Conflict);}
+  if !second_factor&&r.credentials.contains_key(CHALLENGE){return Err(Error::Conflict);}
+  r.credentials.insert(ATTEMPT.into(),attempt.into());r.credentials.insert(CONNECTION.into(),target.connection_id.into());
+  r.account.credential_names=r.credentials.keys().cloned().collect();
+  self.write(&contents)?;
+  let r=contents.accounts.iter_mut().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  let (pre_cookie,pre_csrf)=csrf(target)?;
+  let (path,payload)=if second_factor{
+   let challenge=r.credentials.remove(CHALLENGE).ok_or(Error::Conflict)?;
+   let code=r.credentials.remove("NODE_HOSTED_MFA_CREDENTIAL").ok_or(Error::Conflict)?;
+   ("/api/v1/auth/mfa/challenge",json!({"challengeToken":challenge,"code":code}))
+  }else{
+   let email=r.credentials.get("NODE_HOSTED_EMAIL_CREDENTIAL").ok_or(Error::Invalid)?;
+   let password=r.credentials.get("NODE_HOSTED_PASSWORD").ok_or(Error::Invalid)?;
+   ("/api/v1/auth/login",json!({"email":email,"password":password,"deviceLabel":"Veyra Native"}))
+  };
+  // Persist challenge consumption before effect; both password and MFA are single attempts.
+  self.write(&contents)?;
+  let response=target.client.post(url(target,path)?).header(reqwest::header::ORIGIN,target.dashboard_origin)
+   .header(reqwest::header::COOKIE,pre_cookie).header("x-csrf-token",pre_csrf).json(&payload).send().map_err(|_|Error::Unavailable)?;
+  let session_cookie=if response.status().as_u16()==200{Some(cookie(&response,SESSION)?)}else{None};
+  let value=body(response)?;let data=&value["data"];
+  let r=contents.accounts.iter_mut().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  if data["mfaRequired"]==true&&!second_factor{
+   r.credentials.insert(CHALLENGE.into(),secret(data,"challengeToken")?);
+  }else{
+   let actor=data["user"]["id"].as_str().filter(|s|uuid(s).is_ok()).ok_or(Error::Unavailable)?.to_string();
+   r.credentials.insert(COOKIE.into(),session_cookie.ok_or(Error::Unavailable)?);r.credentials.insert(CSRF.into(),secret(data,"csrfToken")?);
+   r.credentials.insert(ACTOR.into(),actor);
+   // The actual user session is retained, not the login password or single-use code.
+   for name in ["NODE_HOSTED_PASSWORD","NODE_HOSTED_MFA_CREDENTIAL",CHALLENGE]{if let Some(mut value)=r.credentials.remove(name){unsafe{erase(value.as_bytes_mut());}}}
+  }
+  r.credentials.insert("NODE_HOSTED_SESSION_REVISION_TOKEN".into(),uuid::Uuid::new_v4().to_string());
+  r.account.credential_names=r.credentials.keys().cloned().collect();
+  let result=status(r);self.write(&contents)?;Ok(result)
+ }
+ /// The vault lock retains the account original during this bounded private request.
+ /// The hosted server still reauthorizes membership, session and runtime ownership.
+ pub(crate) fn with_node_hosted_session<T>(&self,target:&Target<'_>,expected:&AccountReview,work:impl FnOnce(Session<'_>)->Result<T,Error>)->Result<T,Error>{
+  let _lock=self.lock()?;let contents=self.read()?;let r=contents.accounts.iter().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  if !account_matches(r,expected)||r.credentials.get(CONNECTION).map(String::as_str)!=Some(target.connection_id){return Err(Error::Conflict);}
+  let session=Session{cookie:r.credentials.get(COOKIE).ok_or(Error::Conflict)?,csrf:r.credentials.get(CSRF).ok_or(Error::Conflict)?,actor_id:r.credentials.get(ACTOR).ok_or(Error::Conflict)?,locks:Maintenance{target:r.credentials.get("NODE_HOSTED_TARGET_LOCK_TOKEN").map(String::as_str),source:r.credentials.get("NODE_HOSTED_SOURCE_LOCK_TOKEN").map(String::as_str)}};
+  let value=body(target.client.get(url(target,"/api/v1/auth/session")?).header(reqwest::header::COOKIE,session.cookie).send().map_err(|_|Error::Unavailable)?)?;
+  if value["data"]["user"]["id"].as_str()!=Some(session.actor_id){return Err(Error::Conflict);}
+  work(session)
+ }
+}
+
+// Called only with the actual pinned Node enrollment reply, never a renderer binding.
+impl AccountVault {
+ pub(crate) fn node_hosted_bind_enrollment(&self,expected:&AccountReview,request_id:&str,binding:&crate::remote_control::hosted::contracts::Binding)->Result<AccountReview,Error>{
+  let _lock=self.lock()?;let mut contents=self.read()?;
+  let r=contents.accounts.iter_mut().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  if !account_matches(r,expected)||r.credentials.get(CONNECTION).map(String::as_str)!=Some(request_id)||r.credentials.get(ACTOR)!=Some(&binding.actor_id){return Err(Error::Conflict);}
+  r.credentials.insert(CONNECTION.into(),binding.connection_id.clone());r.credentials.insert("NODE_HOSTED_SESSION_REVISION_TOKEN".into(),uuid::Uuid::new_v4().to_string());
+  r.account.credential_names=r.credentials.keys().cloned().collect();let result=review(r);self.write(&contents)?;Ok(result)
+ }
+}
+
+struct MfaCode(String);
+impl Drop for MfaCode{fn drop(&mut self){unsafe{erase(self.0.as_bytes_mut());}}}
+impl AccountVault {
+ pub(crate) fn node_hosted_mfa_file(&self,expected:&AccountReview,path:&Path)->Result<AccountReview,Error>{
+  // Reuse the original account credential-file reader (native handle/reparse checks + zeroed buffer).
+  let mut values=super::read_credential_file(path)?;
+  let value=values.remove("NODE_HOSTED_MFA_CREDENTIAL");
+  let extra=!values.is_empty();for secret in values.values_mut(){unsafe{erase(secret.as_bytes_mut());}}
+  let code=MfaCode(value.ok_or(Error::Invalid)?);
+  if extra||code.0.len()<6||code.0.len()>128||code.0.chars().any(char::is_control){return Err(Error::Invalid);}
+  let _lock=self.lock()?;let mut contents=self.read()?;
+  let r=contents.accounts.iter_mut().find(|r|r.account.id==expected.account.id).ok_or(Error::NotFound)?;
+  if !account_matches(r,expected)||!r.credentials.contains_key(CHALLENGE)||r.credentials.contains_key(COOKIE){return Err(Error::Conflict);}
+  r.credentials.insert("NODE_HOSTED_MFA_CREDENTIAL".into(),code.0.clone());
+  r.credentials.insert("NODE_HOSTED_SESSION_REVISION_TOKEN".into(),uuid::Uuid::new_v4().to_string());
+  r.account.credential_names=r.credentials.keys().cloned().collect();let result=review(r);self.write(&contents)?;Ok(result)
+ }
+}
diff --git a/crates/adapters/src/remote_control/hosted.rs b/crates/adapters/src/remote_control/hosted.rs
new file mode 100644
--- /dev/null
+++ b/crates/adapters/src/remote_control/hosted.rs
@@ -0,0 +1,196 @@
+//! Explicit NodeHosted capability domain in the existing saved-connection owner.
+//! Native paired requests never enter this domain; neither credentials nor URLs come from the renderer.
+use super::*;
+use crate::account_vault::{AccountVault,node_hosted::{AccountReview,Target}};
+use crate::access_profiles::AccessProfiles;
+pub mod contracts;
+pub mod attestation;
+mod wire;
+pub use wire::{payload_hash,RemotePending};
+use contracts::*;
+
+#[derive(Clone,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Enrollment {
+ pub protocol:String,pub enrollment_request_id:String,pub native_owner:NativeOwner,pub identity:Identity,pub account_review:AccountReview,
+ pub dashboard_origin:String,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TrustFile {pub endpoint:String,pub certificate_pem:String,pub certificate_sha256:String,pub dashboard_origin:String}
+pub struct TrustedEnrollment {pub(crate) trust:TrustFile,pub sha256:String}
+#[derive(Clone,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Retained {pub original:Original,pub private_owner:Enrollment,pub connection:ConnectionView}
+pub struct SessionConnection {saved:StoredConnection,client:reqwest::blocking::Client}
+fn account_error(_:crate::account_vault::Error)->Error{Error::Forbidden}
+impl Store {
+ pub fn hosted_connections(&self)->Result<Vec<Value>,Error>{
+  self.access(|db|db.connections.values().filter_map(|c|c.node_hosted.as_ref().map(|e|json!({"id":c.view.id,"name":c.view.name,"protocol":e.protocol,
+    "actor_id":e.identity.binding.actor_id,"installation_id":e.identity.binding.installation_id,"hosted_project_id":e.identity.binding.hosted_project_id,
+    "native_owner":e.native_owner,"account_id":e.account_review.account.id}))).map(Ok).collect(),false)
+ }
+ pub fn hosted(&self,id:&str)->Result<SessionConnection,Error>{
+  let saved=self.access(|db|db.connections.get(id).cloned().ok_or(Error::NotFound),false)?;
+  let enrollment=saved.node_hosted.as_ref().ok_or(Error::Forbidden)?;
+  if enrollment.protocol!="node_hosted_governance_v1"{return Err(Error::Forbidden);}
+  let client=super::client::pinned_client(&saved.certificate_pem,&saved.view.certificate_sha256)?;
+  Ok(SessionConnection{saved,client})
+ }
+ pub fn save_hosted(&self,id:String,name:String,trust:TrustedEnrollment,enrollment:Enrollment)->Result<ConnectionView,Error>{
+  if !crate::utility_operations::canonical(&id)||enrollment.identity.binding.connection_id!=id||enrollment.protocol!="node_hosted_governance_v1"||
+    enrollment.identity.binding.actor_id!=enrollment.identity.session_actor_id {return Err(Error::Invalid);}
+  let grant=policy_grant(&enrollment.identity);
+  validate_scope(&grant.scope)?;
+  let view=ConnectionView{id,name,endpoint:trust.trust.endpoint,certificate_sha256:trust.trust.certificate_sha256,
+   authority_id:enrollment.identity.binding.authority_id.clone(),service_instance:enrollment.identity.binding.hosted_service_instance_id.clone(),
+   scope:grant.scope};
+  let saved=StoredConnection{view:view.clone(),certificate_pem:trust.trust.certificate_pem,protected_token:None,token:None,grant_id:Some(enrollment.identity.binding.grant_id.clone()),node_hosted:Some(enrollment)};
+  self.access(|db|{if db.connections.contains_key(&view.id)||db.connections.len()>=64{return Err(Error::Conflict);}db.connections.insert(view.id.clone(),saved);Ok(view)},true)
+ }
+ pub fn require_hosted(&self,connection:&SessionConnection)->Result<(),Error>{
+  self.access(|db|{
+   let current=db.connections.get(&connection.saved.view.id).ok_or(Error::NotFound)?;
+   if json!(current.view)!=json!(connection.saved.view)||json!(current.node_hosted)!=json!(connection.saved.node_hosted){return Err(Error::Conflict);}Ok(())
+  },false)
+ }
+}
+impl SessionConnection {
+ pub fn enrollment(&self)->&Enrollment{self.saved.node_hosted.as_ref().expect("validated typed connection")}
+ pub fn view(&self)->&ConnectionView{&self.saved.view}
+ fn target(&self)->Target<'_>{Target{client:&self.client,endpoint:&self.saved.view.endpoint,dashboard_origin:&self.enrollment().dashboard_origin,connection_id:&self.saved.view.id}}
+ /// Current identity is supplied by the Node principal/project authority, never from ConnectionView metadata.
+ pub fn identity(&self,vault:&AccountVault,owner:&NativeOwner)->Result<Identity,Error>{
+  let e=self.enrollment();let target=self.target();
+  if owner.library_id!=e.native_owner.library_id||owner.project.as_ref().map(|p|&p.id)!=e.native_owner.project.as_ref().map(|p|&p.id){return Err(Error::Conflict);}
+  vault.with_node_hosted_session(&target,&e.account_review,|session|{
+   let actual=wire::identity(&target,&session,&e.identity.binding.grant_id).map_err(|_|crate::account_vault::Error::Conflict)?;
+   if actual.binding.connection_id!=self.saved.view.id||
+    actual.binding.authority_id!=e.identity.binding.authority_id||actual.binding.installation_id!=e.identity.binding.installation_id||
+    actual.binding.actor_id!=session.actor_id||actual.session_actor_id!=session.actor_id||
+    actual.binding.hosted_project_id!=e.identity.binding.hosted_project_id||
+    actual.binding.native_library_id!=owner.library_id||actual.binding.native_service_instance_id!=owner.service_instance_id||
+    actual.binding.native_project_id.as_deref()!=owner.project.as_ref().map(|p|p.id.as_str())||
+    actual.binding.native_project_revision!=owner.project.as_ref().map(|p|p.revision)||
+
+    actual.capabilities.iter().any(|c|!e.identity.capabilities.contains(c)){return Err(crate::account_vault::Error::Conflict);}
+   Ok(actual)
+  }).map_err(account_error)
+ }
+ fn authorized(&self,profiles:&AccessProfiles,identity:&Identity,write:bool)->Result<(),Error>{
+  if !profiles.inventory().map_err(|_|Error::Forbidden)?.iter().any(|p|p.grant_id==identity.binding.grant_id){return Err(Error::Forbidden);}
+  let grant=profiles.effective_grant(&policy_grant(identity),now()).map_err(|_|Error::Forbidden)?;
+  let required=if write{"hosted_governance_write"}else{"hosted_governance_read"};
+  if !grant.scope.permissions.iter().any(|p|p==required){return Err(Error::Forbidden);}Ok(())
+ }
+ pub fn read(&self,vault:&AccountVault,profiles:&AccessProfiles,current:&Identity,command:&Read)->Result<Value,Error>{
+  self.authorized(profiles,current,false)?;
+  if !current.capabilities.contains(&command.capability()){return Err(Error::Forbidden);}
+  vault.with_node_hosted_session(&self.target(),&self.enrollment().account_review,|s|wire::read(&self.target(),&s,&current.binding,command).map_err(|_|crate::account_vault::Error::Conflict)).map_err(account_error)
+ }
+ pub fn available(&self,profiles:&AccessProfiles,current:&Identity)->Result<Vec<Capability>,Error>{
+  self.authorized(profiles,current,false)?;
+  let writable=self.authorized(profiles,current,true).is_ok();
+  Ok(current.capabilities.iter().copied().filter(|c|match c{
+   Capability::SynthesisRun|Capability::SynthesisModels=>false,
+   Capability::Create|Capability::Save|Capability::Archive|Capability::Restore|Capability::Enable|Capability::Disable|Capability::Submit|Capability::Approve|Capability::Reject|Capability::Rollback=>writable,
+   _=>true
+  }).collect())
+ }
+ pub fn pending(&self,vault:&AccountVault,profiles:&AccessProfiles,current:&Identity)->Result<Vec<RemotePending>,Error>{
+  self.authorized(profiles,current,false)?;
+  vault.with_node_hosted_session(&self.target(),&self.enrollment().account_review,|s|wire::pending(&self.target(),&s,&current.binding).map_err(|_|crate::account_vault::Error::Unavailable)).map_err(account_error)
+ }
+ pub fn send(&self,vault:&AccountVault,profiles:&AccessProfiles,current:&Identity,original:&Original)->Result<Receipt,Error>{
+  if current.binding!=original.binding||!original.command.validate()||!current.capabilities.contains(&original.command.capability()){return Err(Error::Conflict);}
+  self.authorized(profiles,current,true)?;
+  let intent=hash(&serde_json::to_vec(original).map_err(|_|Error::Invalid)?);
+  profiles.admit(&policy_grant(current),&original.id,&intent,"hosted_governance_write",now()).map_err(|_|Error::Forbidden)?;
+  vault.with_node_hosted_session(&self.target(),&self.enrollment().account_review,|s|wire::effect(&self.target(),&s,original,&s.locks).map_err(|_|crate::account_vault::Error::Unavailable)).map_err(account_error)
+ }
+ pub fn inspect(&self,vault:&AccountVault,profiles:&AccessProfiles,current:&Identity,original:&Original)->Result<Receipt,Error>{
+  self.authorized(profiles,current,false)?;
+  if recovery_key(&current.binding)!=recovery_key(&original.binding){return Err(Error::Forbidden);}
+  vault.with_node_hosted_session(&self.target(),&self.enrollment().account_review,|s|wire::inspect(&self.target(),&s,&current.binding,original).map_err(|_|crate::account_vault::Error::Unavailable)).map_err(account_error)
+ }
+}
+pub fn recovery_key(b:&Binding)->String{
+ hash(&serde_json::to_vec(&json!([b.native_library_id,b.native_service_instance_id,b.hosted_service_instance_id,b.authority_id,b.connection_id,b.actor_id,b.installation_id,b.native_project_id,b.hosted_project_id,b.visibility])).expect("scalar owner"))
+}
+pub fn unknown(original:&Original)->Receipt{Receipt{original:original.clone(),outcome:Outcome::Unknown,value:None,error:Some(PublicError{status:None,code:"hosted_original_unconfirmed".into(),message:"Original outcome remains unconfirmed; inspect this original without replay.".into()})}}
+
+// This only adapts an ALREADY authenticated Node grant to the existing local access-policy API.
+// It creates no Native credential/grant, is never used by Store::authenticate or the generic proxy,
+// and every use requires an explicitly configured managed local policy (no legacy default).
+fn policy_grant(identity:&Identity)->GrantView{
+ let read=identity.capabilities.iter().any(|c|matches!(c,Capability::Catalog|Capability::Skill));
+ let write=identity.capabilities.iter().any(|c|matches!(c,Capability::Create|Capability::Save|Capability::Archive|Capability::Restore|Capability::Enable|Capability::Disable|Capability::Submit|Capability::Approve|Capability::Reject|Capability::Rollback));
+ GrantView{id:identity.binding.grant_id.clone(),revision:identity.binding.grant_revision,revoked:false,created_at:0,
+  scope:Scope{name:"NodeHosted governance policy".into(),project_ids:vec![identity.binding.hosted_project_id.clone()],
+    permissions:[(read,"hosted_governance_read"),(write,"hosted_governance_write")].into_iter().filter(|(present,_)|*present).map(|(_,p)|p.into()).collect()}}
+}
+#[derive(Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AccountCommand {
+ pub operation_id:String,pub enrollment_request_id:String,pub native_owner:NativeOwner,pub account_review:AccountReview,
+ pub trust_file:PathBuf,pub trust_sha256:String,pub second_factor:bool,#[serde(default,skip_serializing_if="Option::is_none")]pub mfa_file:Option<PathBuf>,
+}
+pub fn trusted_file(path:&Path,expected:&str)->Result<TrustedEnrollment,Error>{
+ if !path.is_absolute()||expected.len()!=64{return Err(Error::Invalid);}
+ for ancestor in path.ancestors(){let metadata=fs::symlink_metadata(ancestor).map_err(|_|Error::Invalid)?;if redirected(&metadata){return Err(Error::Invalid);}}
+ let mut options=fs::OpenOptions::new();options.read(true);
+ #[cfg(windows)]{use std::os::windows::fs::OpenOptionsExt;options.share_mode(1).custom_flags(0x00200000);}
+ let file=options.open(path).map_err(|_|Error::Invalid)?;let metadata=file.metadata().map_err(|_|Error::Invalid)?;
+ if redirected(&metadata)||!metadata.is_file()||metadata.len()>256*1024{return Err(Error::Invalid);}
+ let mut bytes=Vec::new();file.take(256*1024+1).read_to_end(&mut bytes).map_err(|_|Error::Unavailable)?;
+ if bytes.len()>256*1024||hash(&bytes)!=expected{return Err(Error::Conflict);}
+ let trust:TrustFile=serde_json::from_slice(&bytes).map_err(|_|Error::Invalid)?;
+ // Use exactly the existing pin verifier and strict HTTPS origin parser.
+ super::client::pinned_client(&trust.certificate_pem,&trust.certificate_sha256)?;
+ for (text,origin_only) in [(&trust.endpoint,true),(&trust.dashboard_origin,true)]{
+  let url=reqwest::Url::parse(text).map_err(|_|Error::Invalid)?;
+  if url.scheme()!="https"||url.host_str().is_none()||!url.username().is_empty()||url.password().is_some()||url.query().is_some()||url.fragment().is_some()||origin_only&&url.path()!="/"{return Err(Error::Invalid);}
+ }
+ if trust.dashboard_origin.ends_with('/'){return Err(Error::Invalid);}
+ Ok(TrustedEnrollment{trust,sha256:expected.into()})
+}
+/// The caller validates the complete saved Native owner and retains AccountCommand first.
+pub fn sign_in(state:&Path,input:&AccountCommand)->Result<crate::account_vault::node_hosted::SessionStatus,Error>{
+ if !crate::utility_operations::canonical(&input.operation_id)||!crate::utility_operations::canonical(&input.enrollment_request_id){return Err(Error::Invalid);}
+ let trust=trusted_file(&input.trust_file,&input.trust_sha256)?;
+ let client=super::client::pinned_client(&trust.trust.certificate_pem,&trust.trust.certificate_sha256)?;
+ let target=Target{client:&client,endpoint:&trust.trust.endpoint,dashboard_origin:&trust.trust.dashboard_origin,connection_id:&input.enrollment_request_id};
+ let vault=AccountVault::new(state);
+ let review=if input.second_factor{input.mfa_file.as_ref().map(|file|vault.node_hosted_mfa_file(&input.account_review,file)).transpose().map_err(account_error)?.unwrap_or_else(||input.account_review.clone())}else{if input.mfa_file.is_some(){return Err(Error::Invalid);}input.account_review.clone()};
+ vault.node_hosted_sign_in(&target,&review,&input.operation_id,input.second_factor).map_err(account_error)
+}
+/// Not serializable: the existing one-use pairing code remains private to the Root Node client custody ceremony.
+pub struct PreparedPairing {pub(crate) code:String,pub expires_at:u64,pub custodian:attestation::Custodian}
+impl Store {
+ pub fn prepare_hosted_pairing(&self,state:&Path,input:&AccountCommand,policy:crate::access_profiles::Policy)->Result<PreparedPairing,Error>{
+  let trust=trusted_file(&input.trust_file,&input.trust_sha256)?;
+  let client=super::client::pinned_client(&trust.trust.certificate_pem,&trust.trust.certificate_sha256)?;
+  let target=Target{client:&client,endpoint:&trust.trust.endpoint,dashboard_origin:&trust.trust.dashboard_origin,connection_id:&input.enrollment_request_id};
+  let actual=AccountVault::new(state).with_node_hosted_session(&target,&input.account_review,|s|wire::site_identity(&target,&s).map_err(|_|crate::account_vault::Error::Conflict)).map_err(account_error)?;
+  let custodian=attestation::Custodian{enrollment_request_id:input.enrollment_request_id.clone(),actor_id:actual.actor_id,installation_id:actual.installation_id,hosted_authority_id:actual.authority_id,native_owner:input.native_owner.clone()};
+  let(code,expires_at)=self.pair_node_custodian(custodian.clone(),policy,&AccessProfiles::new(state))?;
+  Ok(PreparedPairing{code,expires_at,custodian})
+ }
+ /// Called only AFTER Root's actual Node private owner redeems the above pairing and can authenticate its Native context callback.
+ /// If that callback is absent, the frozen server returns503; no self-asserted identity or fallback is accepted.
+ pub fn enroll_hosted(&self,state:&Path,input:&AccountCommand,hosted_project:&str,visibility:Visibility,policy:crate::access_profiles::Policy,name:String)->Result<ConnectionView,Error>{
+  let trust=trusted_file(&input.trust_file,&input.trust_sha256)?;
+  let client=super::client::pinned_client(&trust.trust.certificate_pem,&trust.trust.certificate_sha256)?;
+  let target=Target{client:&client,endpoint:&trust.trust.endpoint,dashboard_origin:&trust.trust.dashboard_origin,connection_id:&input.enrollment_request_id};
+  let vault=AccountVault::new(state);
+  let identity=vault.with_node_hosted_session(&target,&input.account_review,|s|wire::enroll(&target,&s,&input.enrollment_request_id,hosted_project,&visibility).map_err(|_|crate::account_vault::Error::Conflict)).map_err(account_error)?;
+  if identity.binding.native_library_id!=input.native_owner.library_id||identity.binding.native_service_instance_id!=input.native_owner.service_instance_id||
+   identity.binding.native_project_id.as_deref()!=input.native_owner.project.as_ref().map(|p|p.id.as_str())||identity.binding.native_project_revision!=input.native_owner.project.as_ref().map(|p|p.revision){return Err(Error::Conflict);}
+  let review=vault.node_hosted_bind_enrollment(&input.account_review,&input.enrollment_request_id,&identity.binding).map_err(account_error)?;
+  let grant=policy_grant(&identity);let id=identity.binding.connection_id.clone();
+  let profiles=AccessProfiles::new(state);
+  profiles.configure_exact(&grant,0,None,policy,now(),||crate::utility_operations::Store::open(state).and_then(|s|s.hosted_pending(&recovery_key(&identity.binding))).map(|rows|rows.is_empty()).map_err(|_|crate::access_profiles::Error::Unavailable)).map_err(|_|Error::Forbidden)?;
+  let enrollment=Enrollment{protocol:"node_hosted_governance_v1".into(),enrollment_request_id:input.enrollment_request_id.clone(),native_owner:input.native_owner.clone(),identity,account_review:review,dashboard_origin:trust.trust.dashboard_origin.clone()};
+  self.save_hosted(id,name,trust,enrollment)
+ }
+}
