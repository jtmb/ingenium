+@media (max-width: 900px) { .native-customize-sidebar { max-width: none; flex-basis: 100%; border-right: 0; border-bottom: 1px solid var(--border); } .native-customize-sidebar ul { max-height: 7rem; } .native-customize-sidebar nav { grid-template-columns: repeat(auto-fit,minmax(min(100%,12rem),1fr)); } }
+@media (prefers-reduced-motion: reduce) { .native-customize *, .native-customize *::before, .native-customize *::after { scroll-behavior: auto; animation: none; transition: none; } }
