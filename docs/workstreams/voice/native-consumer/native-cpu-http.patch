+//! Proposed native adapter, not an activated runtime. The existing Speech owner
+//! retains request UUIDs, private receipts and helper handles.
+use super::{Error, Input, STANDARD};
+use base64::Engine as _;
+use serde_json::{Value, json};
+use std::{io::Read, sync::atomic::{AtomicBool, Ordering}, time::Duration};
+
+pub(super) enum Failure { Known(Error), RemoteUncertain }
+impl From<Error> for Failure { fn from(value: Error) -> Self { Self::Known(value) } }
+pub(super) type Output = (Option<String>, Option<String>, Value);
+
+#[derive(Clone)]
+pub(super) struct Config { endpoint: String, token: String, instance: String, default_voice: String }
+impl Config {
+    pub(super) fn load() -> super::Result<Option<Self>> {
+        match std::env::var("VEYRA_SPEECH_BACKEND").as_deref() {
+            Err(std::env::VarError::NotPresent) | Ok("local-process") => return Ok(None),
+            Ok("owned-http-cpu") => {},
+            _ => return Err(Error::Unconfigured),
+        }
+        let endpoint = std::env::var("VEYRA_SPEECH_HTTP_URL").map_err(|_| Error::Unconfigured)?;
+        // Literal IPv4 loopback and a port only: no proxy, redirects, URL userinfo,
+        // DNS rebinding, path/query or implicit WSL/remote-host trust expansion.
+        let port = endpoint.strip_prefix("http://127.0.0.1:").ok_or(Error::Unconfigured)?;
+        if port.parse::<u16>().ok().filter(|port| *port > 0).is_none()
+            || !port.bytes().all(|byte| byte.is_ascii_digit()) { return Err(Error::Unconfigured); }
+        let token = protected_token()?;
+        let instance = std::env::var("VEYRA_SPEECH_HTTP_INSTANCE").map_err(|_| Error::Unconfigured)?;
+        let default_voice = std::env::var("VEYRA_SPEECH_HTTP_DEFAULT_VOICE").map_err(|_| Error::Unconfigured)?;
+        if instance.is_empty() || instance.len() > 128 || default_voice.is_empty() || default_voice.len() > 64 {
+            return Err(Error::Unconfigured);
+        }
+        Ok(Some(Self { endpoint, token, instance, default_voice }))
+    }
+    fn agent(&self) -> ureq::Agent {
+        ureq::AgentBuilder::new().redirects(0).try_proxy_from_env(false)
+            .timeout_connect(Duration::from_secs(1)).timeout_read(Duration::from_secs(7))
+            .timeout_write(Duration::from_secs(2)).timeout(Duration::from_secs(9)).build()
+    }
+    fn request(&self, method: &str, path: &str) -> ureq::Request {
+        self.agent().request(method, &format!("{}{path}", self.endpoint))
+            .set("Authorization", &format!("Bearer {}", self.token))
+    }
+    fn health(&self) -> super::Result<Value> {
+        let response = self.request("GET", "/health").call().map_err(|_| Error::Unavailable)?;
+        let body = read(response, 64 * 1024).map_err(|_| Error::Unavailable)?;
+        let health: Value = serde_json::from_slice(&body).map_err(|_| Error::Unavailable)?;
+        if health["service"] != "veyra-speech" || health["version"] != 1
+            || health["protocol"] != "stratus-speech-v1" || health["instanceId"] != self.instance
+            || health["backend"] != "cpu-onnx" || health["ready"] != true
+            || health["tts"] != true || health["stt"] != true
+            || !health["voices"].as_array().is_some_and(|voices| voices.iter().any(|v| v == &self.default_voice)) {
+            return Err(Error::Unavailable);
+        }
+        Ok(health)
+    }
+    pub(super) fn status(&self) -> Value {
+        let health = self.health().ok();
+        json!({"backend":"owned-http-cpu", "transcription_configured":true,
+            "synthesis_configured":true, "available":health.is_some(), "qualified":false,
+            "execution":"explicit Veyra CPU HTTP worker", "realtime_duplex":"unverified",
+            "limits":{"min_recording_ms":250,"max_recording_ms":15000,
+                "max_text_chars":600,"max_text_utf8_bytes":2400,"max_output_ms":15000},
+            "voices":health.as_ref().map(|h| h["voices"].clone()).unwrap_or(json!([])),
+            "configured_default_voice":self.default_voice})
+    }
+    pub(super) fn default_voice(&self) -> String { self.default_voice.clone() }
+    pub(super) fn validate(&self, input: &Input) -> super::Result<()> {
+        validate_input(input)?;
+        let health = self.health()?;
+        if let Input::Synthesize { voice, .. } = input {
+            if !health["voices"].as_array().is_some_and(|voices| voices.iter().any(|v| v == voice)) {
+                return Err(Error::Invalid);
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn execute(&self, id: &str, input: Input, cancel: &AtomicBool) -> Result<Output, Failure> {
+        // Validation/health failures before POST cannot have admitted inference.
+        self.validate(&input)?;
+        if cancel.load(Ordering::Acquire) { return Err(Failure::Known(Error::Unavailable)); }
+        let (path, content_type, body) = match &input {
+            Input::Transcribe(wav) => ("/v1/transcriptions", "application/octet-stream", wav[44..].to_vec()),
+            Input::Synthesize { text, voice } => ("/v1/speech", "application/json",
+                serde_json::to_vec(&json!({"requestId":id,"text":text,"voice":voice})).map_err(|_| Error::Invalid)?),
+        };
+        // The scoped task remains joined by the original native helper. Cancellation
+        // ACK is never returned as the outcome: only this original POST is observed.
+        let result = std::thread::scope(|scope| {
+            let (tx, rx) = std::sync::mpsc::sync_channel(1);
+            scope.spawn(move || {
+                let response = self.request("POST", path).set("Content-Type", content_type)
+                    .set("X-Request-ID", id).send_bytes(&body);
+                let _ = tx.send(response);
+            });
+            let mut cancel_sent = false;
+            loop {
+                if cancel.load(Ordering::Acquire) && !cancel_sent {
+                    cancel_sent = true;
+                    // Best effort cooperative invalidation; no effect on retirement proof.
+                    let _ = self.request("POST", "/v1/cancel")
+                        .send_json(json!({"requestId":id}));
+                }
+                match rx.recv_timeout(Duration::from_millis(20)) {
+                    Ok(response) => break Some(response),
+                    Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {},
+                    Err(_) => break None,
+                }
+            }
+        });
+        let response = match result.ok_or(Failure::RemoteUncertain)? {
+            Ok(response) => response,
+            Err(ureq::Error::Status(status, response)) => {
+                let body = read(response, 4096).map_err(|_| Failure::RemoteUncertain)?;
+                let value: Value = serde_json::from_slice(&body).map_err(|_| Failure::RemoteUncertain)?;
+                return Err(classify_error(status, value["error"]["code"].as_str()));
+            },
+            Err(_) => return Err(Failure::RemoteUncertain),
+        };
+        if response.status() != 200 { return Err(Failure::RemoteUncertain); }
+        let body = read(response, 1_440_044).map_err(|_| Failure::RemoteUncertain)?;
+        let provenance = json!({"remote_cpu":true,"backend":"cpu-onnx","instance_id":self.instance,
+            "qualified":false,"retirement":"original HTTP response after worker inference scope returned"});
+        match input {
+            Input::Transcribe(_) => {
+                let value: Value = serde_json::from_slice(&body).map_err(|_| Failure::RemoteUncertain)?;
+                let text = value["text"].as_str().filter(|t| t.chars().count() <= 2000)
+                    .ok_or(Failure::RemoteUncertain)?;
+                Ok((Some(text.into()), None, provenance))
+            },
+            Input::Synthesize { .. } => {
+                if !valid_output(&body) { return Err(Failure::RemoteUncertain); }
+                Ok((None, Some(STANDARD.encode(body)), provenance))
+            },
+        }
+    }
+}
+
+// Credential custody is qualified only for the native Windows owner. Linux's
+// worker is a separate process; no permissive Unix credential-loader claim is made.
+#[cfg(not(windows))]
+fn protected_token() -> super::Result<String> { Err(Error::Unconfigured) }
+
+#[cfg(windows)]
+fn protected_token() -> super::Result<String> {
+    use std::{fs::OpenOptions, os::windows::fs::OpenOptionsExt,
+        path::{Component, PathBuf, Prefix}};
+    use windows_sys::Win32::{Foundation::GENERIC_READ, Storage::FileSystem::*};
+    use crate::{windows_acl::{verify_owner_only, ProtectedAclKind}, windows_file_metadata::inspect};
+    let path = PathBuf::from(std::env::var_os("VEYRA_SPEECH_HTTP_TOKEN_FILE")
+        .ok_or(Error::Unconfigured)?);
+    if !path.is_absolute() || !matches!(path.components().next(), Some(Component::Prefix(prefix))
+        if matches!(prefix.kind(), Prefix::Disk(_) | Prefix::VerbatimDisk(_)))
+        || !path.to_str().is_some_and(|s| s.len() <= 4096 && !s.chars().any(char::is_control))
+        || path.components().any(|c| matches!(c, Component::ParentDir | Component::CurDir)) {
+        return Err(Error::Unconfigured);
+    }
+    if path.components().any(|component| match component {
+        Component::Normal(name) => name.to_str().is_none_or(|name|
+            name.contains(':') || name.ends_with('.') || name.ends_with(' ')),
+        _ => false,
+    }) { return Err(Error::Unconfigured); }
+    let parent = path.parent().ok_or(Error::Unconfigured)?;
+    let mut captured_path = PathBuf::new();
+    let mut ancestors = Vec::new();
+    for component in parent.components() {
+        captured_path.push(component);
+        if matches!(component, Component::Prefix(_)) { continue; }
+        if ancestors.len() >= 128 { return Err(Error::Unconfigured); }
+        // Use the existing launch-config capture_provision_parent custody pattern:
+        // deny new write/delete directory handles until this bounded read ends.
+        // A conflicting existing handle refuses configuration; no workload is stopped.
+        let guard = OpenOptions::new().access_mode(GENERIC_READ | READ_CONTROL)
+            .share_mode(FILE_SHARE_READ)
+            .custom_flags(FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS)
+            .open(&captured_path).map_err(|_| Error::Unconfigured)?;
+        let facts = inspect(&guard).map_err(|_| Error::Unconfigured)?;
+        if !facts.disk || !facts.directory || facts.reparse || facts.delete_pending {
+            return Err(Error::Unconfigured);
+        }
+        ancestors.push((guard, facts));
+    }
+    let (private_parent, _) = ancestors.last().ok_or(Error::Unconfigured)?;
+    verify_owner_only(private_parent, ProtectedAclKind::Directory).map_err(|_| Error::Unconfigured)?;
+    // One retained plain handle: no pathname metadata/read reopen; sharing denies
+    // concurrent write/delete, including already-open incompatible writer handles.
+    let file = OpenOptions::new().access_mode(GENERIC_READ | READ_CONTROL)
+        .share_mode(FILE_SHARE_READ).custom_flags(FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(&path).map_err(|_| Error::Unconfigured)?;
+    let before = inspect(&file).map_err(|_| Error::Unconfigured)?;
+    if !token_shape(before.disk && !before.directory && !before.reparse && !before.delete_pending,
+        before.links, before.length) { return Err(Error::Unconfigured); }
+    verify_owner_only(&file, ProtectedAclKind::File).map_err(|_| Error::Unconfigured)?;
+    let bytes = bounded_token_bytes(&file)?;
+    let after = inspect(&file).map_err(|_| Error::Unconfigured)?;
+    if !token_observation_matches(before, after, bytes.len()) {
+        return Err(Error::Unconfigured);
+    }
+    for (guard, expected) in &ancestors {
+        if inspect(guard).map_err(|_| Error::Unconfigured)? != *expected {
+            return Err(Error::Unconfigured);
+        }
+    }
+    verify_owner_only(&file, ProtectedAclKind::File).map_err(|_| Error::Unconfigured)?;
+    verify_owner_only(private_parent, ProtectedAclKind::Directory).map_err(|_| Error::Unconfigured)?;
+    // Ancestor guards and the original leaf remain alive through the final checks.
+    decode_token(bytes)
+}
+#[cfg(windows)]
+fn token_observation_matches(before: crate::windows_file_metadata::PhysicalMetadata,
+    after: crate::windows_file_metadata::PhysicalMetadata, read_length: usize) -> bool {
+    before == after && read_length as u64 == before.length
+}
+#[cfg(any(windows, test))]
+fn token_shape(plain: bool, links: u32, length: u64) -> bool {
+    plain && links == 1 && (32..=258).contains(&length)
+}
+#[cfg(any(windows, test))]
+fn bounded_token_bytes(reader: impl Read) -> super::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    reader.take(259).read_to_end(&mut bytes).map_err(|_| Error::Unconfigured)?;
+    if !(32..=258).contains(&bytes.len()) { return Err(Error::Unconfigured); }
+    Ok(bytes)
+}
+#[cfg(any(windows, test))]
+fn decode_token(bytes: Vec<u8>) -> super::Result<String> {
+    let text = String::from_utf8(bytes).map_err(|_| Error::Unconfigured)?;
+    let token = text.trim();
+    if !(32..=192).contains(&token.len()) || !token.bytes().all(|b| b.is_ascii_graphic()) {
+        return Err(Error::Unconfigured);
+    }
+    Ok(token.to_owned())
+}
+
+fn read(response: ureq::Response, max: usize) -> std::io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    response.into_reader().take((max + 1) as u64).read_to_end(&mut bytes)?;
+    if bytes.len() > max { return Err(std::io::Error::other("bounded response exceeded")); }
+    Ok(bytes)
+}
+fn validate_input(input: &Input) -> super::Result<()> {
+    match input {
+        Input::Transcribe(wav) if wav.len() >= 8044 && wav.len() <= 480044 => super::validate_recording(wav),
+        Input::Synthesize { text, .. } if !text.trim().is_empty() && text.chars().count() <= 600
+            && text.len() <= 2400 && !text.chars().any(|c| c < ' ' && c != '\n' && c != '\t') => Ok(()),
+        _ => Err(Error::Invalid),
+    }
+}
+fn classify_error(status: u16, code: Option<&str>) -> Failure {
+    // Only errors emitted by the inspected synchronous Application contract prove
+    // no remaining inference in THIS original handler. Unknown/malformed errors quarantine.
+    match (status, code) {
+        (409, Some("CANCELLED")) | (504, Some("DEADLINE"))
+        | (503, Some("SPEECH_BACKEND_FAILED" | "BACKEND_UNAVAILABLE"))
+        | (502, Some("TRANSCRIPT_LIMIT" | "INVALID_MODEL_AUDIO" | "AUDIO_LIMIT" | "EMPTY_AUDIO"))
+        | (429, Some("BUSY")) => Failure::Known(Error::Unavailable),
+        (400, Some("INVALID_AUDIO" | "INVALID_TEXT" | "UNKNOWN_VOICE" | "INVALID_REQUEST"))
+        | (413, Some("BODY_LIMIT")) | (415, Some("INVALID_CONTENT_TYPE"))
+        | (401, Some("UNAUTHORIZED")) => Failure::Known(Error::Invalid),
+        _ => Failure::RemoteUncertain,
+    }
+}
+pub(super) fn receipt_blocks(operation: &super::Operation, enrolled: bool) -> bool {
+    operation.provenance["remote_cpu"] == true
+        && (operation.state == "uncertain" || (operation.state == "running" && !enrolled))
+}
+fn valid_output(bytes: &[u8]) -> bool {
+    if bytes.len() < 46 || &bytes[0..4] != b"RIFF" || &bytes[8..16] != b"WAVEfmt "
+        || &bytes[16..20] != 16u32.to_le_bytes().as_slice()
+        || &bytes[20..24] != [1,0,1,0] || &bytes[32..36] != [2,0,16,0]
+        || &bytes[36..40] != b"data" { return false; }
+    let word = |offset| u32::from_le_bytes(bytes[offset..offset+4].try_into().unwrap());
+    let rate = word(24);
+    [16000,22050,24000,44100,48000].contains(&rate) && word(28) == rate*2
+        && word(4) as usize == bytes.len()-8 && word(40) as usize == bytes.len()-44
