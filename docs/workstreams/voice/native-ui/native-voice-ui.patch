+/** Read-only presentation/admission limits from the existing native speech owner.
+ * This module owns no request, device, transcript or operation receipt. */
+export type SpeechCapabilities = {
+  backend: "local-process" | "owned-http-cpu" | "unavailable";
+  available: boolean; transcription: boolean; synthesis: boolean;
+  minRecordingMs: number; maxRecordingMs: number; maxTurnMs: number;
+  maxTextChars: number; maxTextBytes: number;
+  voices: readonly string[]; defaultVoice?: string; reason: string;
+};
+type Obj = Record<string, unknown>;
+const object = (value: unknown): Obj => value && typeof value === "object" && !Array.isArray(value) ? value as Obj : {};
+const integer = (value: unknown, floor: number, ceiling: number): value is number =>
+  typeof value === "number" && Number.isInteger(value) && value >= floor && value <= ceiling;
+const voiceId = (value: unknown): value is string => typeof value === "string" && /^[A-Za-z0-9_]{1,64}$/.test(value);
+
+export function speechCapabilities(value: unknown): SpeechCapabilities {
+  const status = object(value);
+  const local: SpeechCapabilities = { backend: "local-process", available: true,
+    transcription: status.transcription_configured === true, synthesis: status.synthesis_configured === true,
+    minRecordingMs: 0, maxRecordingMs: 60000, maxTurnMs: 20000,
+    maxTextChars: 2000, maxTextBytes: Infinity, voices: [], defaultVoice: "af_sarah", reason: "" };
+  // Older native local-process status omitted backend; its existing behavior is retained.
+  if (status.backend === undefined || status.backend === "local-process") return local;
+  const unavailable: SpeechCapabilities = { ...local, backend: "unavailable", available: false,
+    transcription: false, synthesis: false, reason: "The selected speech backend is unavailable. Refresh its existing configuration before starting." };
+  if (status.backend !== "owned-http-cpu") return unavailable;
+  const limits = object(status.limits), voices = status.voices;
+  if (!integer(limits.min_recording_ms, 250, 15000) || !integer(limits.max_recording_ms, 250, 15000)
+    || limits.min_recording_ms > limits.max_recording_ms || !integer(limits.max_text_chars, 1, 600)
+    || !integer(limits.max_text_utf8_bytes, 1, 2400) || !integer(limits.max_output_ms, 1, 15000)
+    || !Array.isArray(voices) || !voices.length || voices.length > 256 || !voices.every(voiceId)
+    || new Set(voices).size !== voices.length || !voiceId(status.configured_default_voice)
+    || !voices.includes(status.configured_default_voice)) {
+    return { ...unavailable, backend: "owned-http-cpu", reason: "CPU speech limits or advertised voices are missing or invalid. No audio or text will be submitted." };
+  }
+  const available = status.available === true;
+  return { backend: "owned-http-cpu", available,
+    transcription: available && status.transcription_configured === true,
+    synthesis: available && status.synthesis_configured === true,
+    minRecordingMs: limits.min_recording_ms, maxRecordingMs: limits.max_recording_ms,
+    maxTurnMs: limits.max_recording_ms, maxTextChars: limits.max_text_chars,
+    maxTextBytes: limits.max_text_utf8_bytes, voices, defaultVoice: status.configured_default_voice,
+    reason: available ? "" : "The selected CPU speech worker is unavailable. Original requests remain retained." };
+}
+
+export type SpeechPlan = { ok: true; text: string; voice?: string } | { ok: false; message: string };
+export function selectedVoice(selection: string, caps: SpeechCapabilities): { ok: true; voice?: string } | { ok: false; message: string } {
+  const voice = selection.trim();
+  if (caps.backend === "unavailable" || !caps.available) return { ok: false, message: caps.reason };
+  if (caps.backend === "local-process") return !voice || voiceId(voice)
+    ? { ok: true, ...(voice ? { voice } : {}) } : { ok: false, message: "Use a configured voice ID containing letters, numbers or underscores." };
+  const original = voice || caps.defaultVoice;
+  return original && caps.voices.includes(original) ? { ok: true, voice: original }
+    : { ok: false, message: `The selected voice ${voice || "(no configured default)"} is not advertised by the CPU backend. It was not replaced.` };
+}
+
+export function speechPlan(reply: string, selection: string, caps: SpeechCapabilities): SpeechPlan {
+  const voice = selectedVoice(selection, caps);
+  if (!voice.ok) return voice;
+  const text = reply.trim();
+  if (!text) return { ok: false, message: "There is no reply text to speak." };
+  if (caps.backend === "local-process") return { ...voice, text: text.slice(0, 2000) };
+  let count = 0;
+  for (const character of text) {
+    if (++count > caps.maxTextChars) return { ok: false, message: `The complete reply exceeds the CPU limit of ${caps.maxTextChars} characters. It was not shortened or submitted.` };
+    const code = character.charCodeAt(0);
+    if ((character.length === 1 && code >= 0xd800 && code <= 0xdfff) || (code < 32 && character !== "\n" && character !== "\t"))
+      return { ok: false, message: "The reply contains unsupported speech text. No text was submitted." };
+  }
+  if (new TextEncoder().encode(text).length > caps.maxTextBytes)
+    return { ok: false, message: `The complete reply exceeds the CPU limit of ${caps.maxTextBytes} UTF-8 bytes. It was not shortened or submitted.` };
+  return { ...voice, text };
+}
+
+/** A failed preparation is a known local refusal, before reserving an original. */
+export function recordingFrames(durationMs: number, caps: SpeechCapabilities, continuous = false): number {
+  const maximum = continuous ? caps.maxTurnMs : caps.maxRecordingMs;
+  if (!caps.available || !caps.transcription) throw new Error(caps.reason || "Transcription is not configured. No audio was submitted.");
+  if (!Number.isFinite(durationMs) || durationMs <= 0 || (caps.backend === "owned-http-cpu"
+    ? durationMs < caps.minRecordingMs || durationMs > maximum : durationMs > maximum + (continuous ? 50 : 500)))
+    throw new Error(`The recording must contain ${caps.minRecordingMs ? `${caps.minRecordingMs / 1000}–` : "at most "}${maximum / 1000} seconds. No audio was submitted.`);
+  // Only the existing local-process path retains its historical boundary tolerance.
+  const frames = continuous ? Math.floor(durationMs * 16) : Math.ceil(durationMs * 16);
+  if (caps.backend === "owned-http-cpu") {
+    if (frames < caps.minRecordingMs * 16 || frames > maximum * 16) throw new Error("The complete recording exceeds CPU audio limits. No audio was submitted.");
+    return frames;
+  }
+  return Math.min(maximum * 16, frames);
+}
+
+/** Bound the next whole VAD frame. CPU admission never retains a prefix of an
+ * oversized turn; the local-process path keeps its existing frame clipping. */
+export function captureFrame(count: number, length: number, rate: number, caps: SpeechCapabilities):
+  { ok: true; length: number } | { ok: false; message: string } {
+  const maximum = Math.floor(rate * caps.maxTurnMs / 1000);
+  if (caps.backend === "unavailable") return { ok: false, message: caps.reason };
+  if (caps.backend === "owned-http-cpu" && (!caps.transcription || !Number.isFinite(rate) || rate <= 0 || count + length > maximum))
+    return { ok: false, message: `The complete spoken turn exceeds the ${caps.maxTurnMs / 1000}-second CPU limit or its backend is unavailable. No audio was submitted.` };
+  return { ok: true, length: caps.backend === "owned-http-cpu" ? length : Math.max(0, Math.min(length, maximum - count)) };
+}
