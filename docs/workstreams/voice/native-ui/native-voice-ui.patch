+import { useState, type ReactNode } from "react";
+
+/** Presentation only. The child supplies attention from its original owner state;
+ * user collapse cannot hide live stop or original-request recovery controls. */
+export function AttentionDetails({ needed, className, summary, children }: {
+  needed: boolean; className: string; summary: ReactNode; children: ReactNode;
+}) {
+  const [expanded, setExpanded] = useState(false);
+  return <details className={className} open={needed || expanded} onToggle={event => {
+    if (needed && !event.currentTarget.open) event.currentTarget.open = true;
+    else setExpanded(event.currentTarget.open);
+  }}><summary>{summary}</summary>{children}</details>;
+}
