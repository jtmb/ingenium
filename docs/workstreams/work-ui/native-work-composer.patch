+export function NativeWorkDisclosure({ enabled, label, children, attention = false, hostRef }: { enabled: boolean; label: string; children: ReactNode; attention?: boolean; hostRef?: Ref<HTMLDetailsElement> }) {
+  return enabled ? <details ref={hostRef} className="native-work-disclosure" open={attention || undefined} onToggle={event => {
