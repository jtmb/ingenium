+/** Composer-only visibility adapter. Observe the existing owners' semantic
+ * alerts, never their private state or transport. Reveal nested recovery UI
+ * without unmounting it, dispatching work, or changing admission readiness. */
+export function NativeWorkComposerOptions({ enabled, attention, children }: { enabled: boolean; attention: boolean; children: ReactNode }) {
+  const host = useRef<HTMLDetailsElement>(null);
+  const [childAlert, setChildAlert] = useState(false);
+  useLayoutEffect(() => {
+    if (!enabled || !host.current) return;
+    const root = host.current;
+    const revealAlerts = () => {
+      const alerts = root.querySelectorAll('[role="alert"]');
+      setChildAlert(alerts.length > 0);
+      for (const alert of alerts) {
+        let disclosure = alert.closest("details");
+        while (disclosure && root.contains(disclosure)) {
+          disclosure.open = true;
+          disclosure = disclosure.parentElement?.closest("details") ?? null;
+        }
+      }
+    };
+    revealAlerts();
+    const observer = new MutationObserver(revealAlerts);
+    observer.observe(root, { childList: true, subtree: true, attributes: true, attributeFilter: ["role"] });
+    return () => observer.disconnect();
+  }, [enabled]);
+  return <NativeWorkDisclosure enabled={enabled} label="Composer options" attention={attention || childAlert} hostRef={host}>{children}</NativeWorkDisclosure>;
