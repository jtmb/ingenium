+    if present{let raw=r.get_ref(5)?.as_str()?;if raw.chars().any(char::is_control){return Err(rusqlite::Error::InvalidQuery)}content.append(raw.as_bytes()).map_err(|_|rusqlite::Error::InvalidQuery)?;}
