diff --git a/apps/web/src/features/work-ui/LiveSessionSidebarWork.test.tsx b/apps/web/src/features/work-ui/LiveSessionSidebarWork.test.tsx
new file mode 100644
index 00000000..fe6e8f70
--- /dev/null
+++ b/apps/web/src/features/work-ui/LiveSessionSidebarWork.test.tsx
@@ -0,0 +1,45 @@
+import { cleanup, fireEvent, render, screen, within } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Gateway } from "../../platform/types";
+import { LiveSessionSidebar } from "../workbench/LiveSessionSidebar";
+
+afterEach(cleanup);
+function fixture() {
+  const workbench = vi.fn().mockResolvedValue({ sessions: [
+    { id: "recent-z", title: "Recent Z", presentation: { revision: 1, pinned: false } },
+    { id: "pinned-z", title: "Pinned Z", presentation: { revision: 1, pinned: true } },
+    { id: "recent-a", title: "Recent A", presentation: { revision: 1, pinned: false } },
+    { id: "pinned-a", title: "Pinned A", presentation: { revision: 1, pinned: true } },
+  ] });
+  return { gateway: { workbench } as Gateway, workbench };
+}
+describe("existing session owner Work grouping", () => {
+  it("groups actual pin flags around the existing Projects slot, preserving returned order and actions without writes", async () => {
+    const { gateway, workbench } = fixture();
+    const view = render(<LiveSessionSidebar gateway={gateway} projectId="project" connected selectedId={null}
+      onSelect={vi.fn()} presentation="work" betweenGroups={<section aria-label="Projects"><h3>Projects</h3></section>} />);
+    await screen.findByRole("button", { name: "Recent A", exact: true });
+    const pins = within(screen.getByRole("region", { name: "Pinned conversations" }));
+    const recents = within(screen.getByRole("region", { name: "Recent conversations" }));
+    expect(pins.getAllByRole("button", { name: /^Pinned / }).map(node => node.textContent)).toEqual(["Pinned Z", "Pinned A"]);
+    expect(recents.getAllByRole("button", { name: /^Recent / }).map(node => node.textContent)).toEqual(["Recent Z", "Recent A"]);
+    expect(Array.from(view.container.querySelectorAll("h3")).map(node => node.textContent)).toEqual(["Pinned", "Projects", "Recents"]);
+    fireEvent.click(screen.getByLabelText("Actions for Pinned Z"));
+    expect(pins.getByRole("button", { name: "Unpin", exact: true })).toBeTruthy();
+    fireEvent.click(screen.getByText("Conversation options"));
+    expect(screen.getByRole("button", { name: "Show archived" })).toBeTruthy();
+    expect(workbench.mock.calls.every(([method]) => method === "GET")).toBe(true);
+    expect(workbench).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps the default legacy Chats presentation and its original controls", async () => {
+    const { gateway, workbench } = fixture();
+    render(<LiveSessionSidebar gateway={gateway} projectId="project" connected selectedId={null} onSelect={vi.fn()} />);
+    await screen.findByRole("button", { name: "Recent A", exact: true });
+    expect(screen.getByText("Chats")).toBeTruthy();
+    expect(screen.queryByRole("region", { name: "Pinned conversations" })).toBeNull();
+    expect(screen.getByRole("button", { name: "Refresh conversations" })).toBeTruthy();
+    expect(screen.getByRole("button", { name: "Show archived" })).toBeTruthy();
+    expect(workbench.mock.calls.every(([method]) => method === "GET")).toBe(true);
+  });
+});
