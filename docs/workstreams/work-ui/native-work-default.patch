+import { useId } from "react";
+
+export function NativeWorkNoProjectActions({ scratchAvailable, creating, resumable, onCreateScratch, onChooseProject }: {
+  scratchAvailable: boolean; creating: boolean; resumable: boolean;
+  onCreateScratch: () => void; onChooseProject?: () => void;
+}) {
+  const reason = useId();
+  return <div className="native-work-no-project-actions" role="group" aria-label="No-project chat actions">
+    <button type="button" className="button new-task" disabled aria-describedby={reason}>New chat</button>
+    <p id={reason} role="status">New chat without a project is unavailable until the native service provides a private execution owner.</p>
+    <button type="button" className="button" disabled={!scratchAvailable || creating}
+      title="Creates an actual scratch project with its own directory; this is not a chat without a project."
+      onClick={onCreateScratch}>{creating ? "Creating scratch project…" : resumable ? "Resume scratch project creation" : "Create scratch project"}</button>
+    {onChooseProject && <button type="button" className="button" onClick={onChooseProject}>Choose project</button>}
+  </div>;
+}
