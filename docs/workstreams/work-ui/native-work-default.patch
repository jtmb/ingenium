@@ -0,0 +1,53 @@
+import { useEffect } from "react";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Gateway } from "../../platform/types";
+
+const state = vi.hoisted(() => ({ mounted: vi.fn(), disposed: vi.fn(), diagnostics: vi.fn() }));
+vi.mock("../../platform/gateway", () => ({ desktopGateway: {} }));
+vi.mock("../../app/App", () => ({
+  App: ({ workDefault, onOpenDiagnostics }: { workDefault: boolean; onOpenDiagnostics: () => void }) => {
+    useEffect(() => { state.mounted(); return state.disposed; }, []);
+    return <section><p>{workDefault ? "Native Work default" : "Wrong default"}</p>
+      <label>Owned draft<textarea defaultValue="Preserve original" /></label>
+      <p>Unconfirmed admission original retained</p>
+      <button type="button" onClick={onOpenDiagnostics}>Connection and engine diagnostics</button></section>;
+  },
+}));
+vi.mock("../../app/MvpDesktop", () => ({
+  MvpDesktop: () => { state.diagnostics(); return <p>Existing connection and qualification controls</p>; },
+}));
+import { NativeWorkDesktop } from "./NativeWorkDesktop";
+
+const modal = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, "showModal");
+const close = Object.getOwnPropertyDescriptor(HTMLDialogElement.prototype, "close");
+beforeEach(() => {
+  Object.defineProperty(HTMLDialogElement.prototype, "showModal", { configurable: true, value(this: HTMLDialogElement) { this.setAttribute("open", ""); } });
+  Object.defineProperty(HTMLDialogElement.prototype, "close", { configurable: true, value(this: HTMLDialogElement) { this.removeAttribute("open"); } });
+});
+afterEach(() => {
+  cleanup(); vi.clearAllMocks();
+  if (modal) Object.defineProperty(HTMLDialogElement.prototype, "showModal", modal);
+  else Reflect.deleteProperty(HTMLDialogElement.prototype, "showModal");
+  if (close) Object.defineProperty(HTMLDialogElement.prototype, "close", close);
+  else Reflect.deleteProperty(HTMLDialogElement.prototype, "close");
+});
+describe("native Work default", () => {
+  it("starts in Work and opens diagnostics only by explicit action without replacing its owner", async () => {
+    render(<NativeWorkDesktop gateway={{} as Gateway} />);
+    expect(screen.getByText("Native Work default")).toBeTruthy();
+    expect(state.diagnostics).not.toHaveBeenCalled();
+    const draft = screen.getByLabelText("Owned draft");
+    fireEvent.change(draft, { target: { value: "Exact edited original" } });
+    const trigger = screen.getByRole("button", { name: "Connection and engine diagnostics" });
+    trigger.focus(); fireEvent.click(trigger);
+    await screen.findByText("Existing connection and qualification controls");
+    expect(screen.getByRole("dialog", { name: "Connection and engine diagnostics" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Return to Work" }));
+    await waitFor(() => expect(screen.queryByRole("dialog")).toBeNull());
+    expect(screen.getByLabelText("Owned draft")).toBe(draft);
+    expect((draft as HTMLTextAreaElement).value).toBe("Exact edited original");
+    expect(document.activeElement).toBe(trigger);
+    expect(state.mounted).toHaveBeenCalledTimes(1); expect(state.disposed).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/src/features/work-ui/NativeWorkDesktop.tsx b/apps/web/src/features/work-ui/NativeWorkDesktop.tsx
new file mode 100644
index 00000000..c12593cb
--- /dev/null
+++ b/apps/web/src/features/work-ui/NativeWorkDesktop.tsx
@@ -0,0 +1,39 @@
+import { lazy, Suspense, useLayoutEffect, useRef, useState } from "react";
+import type { Gateway } from "../../platform/types";
+import { desktopGateway } from "../../platform/gateway";
+import { App } from "../../app/App";
+import "./native-work.css";
+
+const Diagnostics = lazy(() => import("../../app/MvpDesktop").then(module => ({ default: module.MvpDesktop })));
+
+/** DesktopEntry remains the admission boundary outside this presentation. */
+export function NativeWorkDesktop({ gateway = desktopGateway }: { gateway?: Gateway }) {
+  const [diagnostics, setDiagnostics] = useState(false);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const trigger = useRef<HTMLElement | null>(null);
+  useLayoutEffect(() => {
+    if (!diagnostics || !dialog.current) return;
+    const surface = dialog.current;
+    // Native dialog supplies focus containment and Escape. The open fallback
+    // supports DOM-only tests without claiming desktop modal qualification.
+    if (typeof surface.showModal === "function") surface.showModal();
+    else surface.setAttribute("open", "");
+    return () => {
+      if (typeof surface.close === "function" && surface.open) surface.close();
+      trigger.current?.focus({ preventScroll: true });
+    };
+  }, [diagnostics]);
+  return <div className="native-work-desktop">
+    <div className="native-work-app" inert={diagnostics} aria-hidden={diagnostics}>
+      <App gateway={gateway} workDefault onOpenDiagnostics={() => {
+        trigger.current = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+        setDiagnostics(true);
+      }} />
+    </div>
+    {diagnostics && <dialog ref={dialog} className="native-work-diagnostics" aria-label="Connection and engine diagnostics"
+      onCancel={event => { event.preventDefault(); setDiagnostics(false); }}>
+      <header><h1>Connection and engine diagnostics</h1><button type="button" autoFocus onClick={() => setDiagnostics(false)}>Return to Work</button></header>
+      <Suspense fallback={<p role="status">Opening diagnostics…</p>}><Diagnostics gateway={gateway} /></Suspense>
+    </dialog>}
+  </div>;
+}
