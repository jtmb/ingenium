+/* Native presentation only. All engine, transcript, file, review and admission
+   behavior stays in the existing App / Workbench / platform gateway owners. */
+.native-work-desktop, .native-work-app { height: 100%; min-height: 0; }
+.native-work-default.desktop { grid-template-columns: 52px var(--sidebar-width, 244px) minmax(0, 1fr); }
+.native-work-default.desktop.sidebar-collapsed { grid-template-columns: 52px minmax(0, 1fr); }
+.native-work-default .global-rail { padding-top: 12px; }
+.native-work-default .rail-links { gap: 6px; }
+.native-work-default .sidebar { background: var(--sidebar); }
+.native-work-default .sidebar-heading { border-bottom-color: transparent; }
+.native-work-default .history-topbar { height: auto; min-height: 44px; flex-wrap: wrap; gap: 8px; border-bottom-color: transparent; }
+.native-work-default .statusbar { min-height: 24px; }
+.native-work-presentation { display: flex; flex-direction: column; height: 100%; min-height: 0; min-width: 0; background: var(--canvas); }
+.native-work-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 8px 16px; flex-shrink: 0; }
+.native-work-heading button, .native-work-unavailable button { border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; background: transparent; color: var(--text); font: inherit; cursor: pointer; }
+.native-work-heading button:focus-visible, .native-work-unavailable button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.native-work-project { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); }
+.native-work-switch { display: flex; border: 1px solid var(--border); border-radius: 10px; padding: 3px; }
+.native-work-switch button { border: 0; }
+.native-work-heading button[aria-pressed=true] { background: var(--control); }
+.native-work-viewport { flex: 1; min-height: 0; position: relative; }
+/* visibility retains geometry and scroll; inert removes inactive keyboard and
+   accessibility access. Never display:none the owner during a Web toggle. */
+.native-work-surface { position: absolute; inset: 0; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
+.native-work-surface[data-active=false] { visibility: hidden; pointer-events: none; }
+.native-work-unavailable { align-items: center; justify-content: center; padding: 24px; overflow-y: auto; text-align: center; }
+.native-work-unavailable p { max-width: 56ch; color: var(--muted); line-height: 1.6; }
+.native-work-welcome { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; min-height: 0; overflow-y: auto; padding: 24px; text-align: center; }
+.native-work-welcome h1 { font-size: 1.6rem; font-weight: 500; }
+.native-work-welcome p { max-width: 52ch; color: var(--muted); line-height: 1.6; }
+.native-work-welcome > div { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
+.native-work-no-project-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 8px; }
+.native-work-no-project-actions p { flex-basis: 100%; color: var(--muted); line-height: 1.5; }
+.native-work-no-project-actions button:disabled { cursor: not-allowed; opacity: .55; }
+.native-work-presentation .wb-toolbar { flex-wrap: wrap; padding: 8px 16px; gap: 8px; min-height: 40px; background: var(--canvas); border-bottom-color: transparent; }
+.native-work-presentation .wb-sessionbar { flex-wrap: wrap; padding: 6px 16px; border-bottom-color: transparent; }
+.native-work-presentation .wb-chat { border-right: 0; }
+.native-work-presentation .wb-messages { padding-inline: max(16px, calc((100% - 740px) / 2)); }
+.native-work-presentation .wb-composer { width: min(740px, calc(100% - 32px)); margin: 12px auto 20px; border-radius: 20px; background: var(--elevated); }
+.native-work-presentation .wb-composer textarea { background: transparent; }
+.native-work-presentation[data-tools=false] .wb-inspector:not(.is-open) { display: none; }
+.native-work-presentation[data-tools=false] .wb-body:not(.wb-inspector-open) { grid-template-columns: minmax(0, 1fr); }
+.native-work-presentation[data-terminal=false] .wb-bottom { display: none; }
+.native-work-presentation .wb-compact-tools-toggle { display: inline-flex; }
+.native-work-diagnostics { width: min(1200px, calc(100vw - 32px)); height: min(900px, calc(100dvh - 32px)); padding: 0; color: var(--text); background: var(--canvas); border: 1px solid var(--border); border-radius: 12px; }
+.native-work-diagnostics::backdrop { background: #0009; }
+.native-work-diagnostics > header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 20px; }
+.native-work-diagnostics h1 { font-size: 1rem; }
+.native-work-diagnostics > .mvp-desktop { height: calc(100% - 64px); min-height: 0; }
+.native-work-diagnostics > header button { padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border); background: var(--control); color: var(--text); }
+@media (max-width: 900px) {
+  .native-work-heading { padding: 8px; }
+  .native-work-heading > .native-work-project { flex-basis: 100%; }
+  .native-work-presentation[data-tools=true] .wb-body { grid-template-columns: minmax(0, 1fr); }
+  .native-work-presentation[data-tools=true] .wb-inspector { display: flex; min-height: 0; overflow: auto; }
+  .native-work-presentation[data-tools=true] .wb-chat { display: none; }
+  .native-work-presentation .wb-composer { width: calc(100% - 16px); margin: 8px auto; }
+}
diff --git a/apps/web/src/features/work-ui/scratchProjectStart.ts b/apps/web/src/features/work-ui/scratchProjectStart.ts
new file mode 100644
index 00000000..9ba3cf59
--- /dev/null
+++ b/apps/web/src/features/work-ui/scratchProjectStart.ts
@@ -0,0 +1,14 @@
+export type ScratchProjectIntent = "new-chat" | "explicit-scratch-project";
+
+/**
+ * A scratch allocation creates a real Project. Work-default New chat may not
+ * substitute that effect for a missing private/null-project execution owner.
+ * Keep the legacy owner unchanged when called outside the Work-default facade.
+ */
+export async function startScratchProject(
+  workDefault: boolean, intent: ScratchProjectIntent, originalOwner: () => Promise<void>,
+): Promise<boolean> {
+  if (workDefault && intent !== "explicit-scratch-project") return false;
+  await originalOwner();
+  return true;
+}
