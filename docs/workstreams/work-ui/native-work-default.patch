+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { NativeWorkNoProjectActions } from "./NativeWorkNoProjectActions";
+import { startScratchProject } from "./scratchProjectStart";
+
+afterEach(cleanup);
+describe("Work without a qualified private project owner", () => {
+  it("does not allocate a project, engine or prompt for New chat, including a direct legacy fallback", async () => {
+    const gateway = { workbench: vi.fn().mockResolvedValue(undefined) };
+    const allocateProject = async () => { await gateway.workbench("POST", "/v1/scratch"); };
+    render(<NativeWorkNoProjectActions scratchAvailable creating={false} resumable={false}
+      onCreateScratch={() => { void startScratchProject(true, "explicit-scratch-project", allocateProject); }} />);
+    const newChat = screen.getByRole("button", { name: "New chat", exact: true });
+    expect(newChat.hasAttribute("disabled")).toBe(true);
+    fireEvent.click(newChat);
+    // The same guard wraps App's original no-selection rail and task-view
+    // fallbacks, even if a stale callback is invoked despite the disabled UI.
+    expect(await startScratchProject(true, "new-chat", allocateProject)).toBe(false);
+    expect(gateway.workbench).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "Create scratch project" }));
+    await waitFor(() => expect(gateway.workbench).toHaveBeenCalledTimes(1));
+    expect(gateway.workbench).toHaveBeenLastCalledWith("POST", "/v1/scratch");
+  });
+
+  it("preserves the legacy fallback outside workDefault and labels pending scratch-project recovery truthfully", async () => {
+    const originalOwner = vi.fn().mockResolvedValue(undefined);
+    expect(await startScratchProject(false, "new-chat", originalOwner)).toBe(true);
+    expect(originalOwner).toHaveBeenCalledTimes(1);
+    render(<NativeWorkNoProjectActions scratchAvailable creating={false} resumable onCreateScratch={originalOwner} />);
+    expect(screen.getByRole("button", { name: "Resume scratch project creation" })).toBeTruthy();
+    expect(screen.queryByRole("button", { name: "Resume new chat" })).toBeNull();
+  });
+});
