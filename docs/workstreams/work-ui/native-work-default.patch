+import { useEffect, useState } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { NativeWorkPresentation } from "./NativeWorkPresentation";
+
+afterEach(cleanup);
+describe("native Work presentation boundary", () => {
+  it("retains the actual child owner, draft, scroll and unknown original across Web return", () => {
+    const mounted = vi.fn(), disposed = vi.fn(), send = vi.fn();
+    function ExistingOwner() {
+      const [draft, setDraft] = useState("Exact pending original");
+      useEffect(() => { mounted(); return disposed; }, []);
+      return <div><label>Native draft<textarea value={draft} onChange={event => setDraft(event.target.value)} /></label>
+        <div data-testid="transcript">Authoritative native transcript</div>
+        <p>Original admission outcome unknown; review before retry</p>
+        <button type="button" disabled onClick={send}>Send message</button></div>;
+    }
+    render(<NativeWorkPresentation scope="instance/project/session-a" projectName="Project"><ExistingOwner /></NativeWorkPresentation>);
+    fireEvent.change(screen.getByLabelText("Native draft"), { target: { value: "Original with exact edits" } });
+    const transcript = screen.getByTestId("transcript"); transcript.scrollTop = 120;
+    fireEvent.click(screen.getByRole("button", { name: "Web", exact: true }));
+    expect(screen.getByText("Web is unavailable for this conversation")).toBeTruthy();
+    const inactive = screen.getByLabelText("Native Work presentation");
+    expect(inactive.hasAttribute("inert")).toBe(true); expect(inactive.hasAttribute("hidden")).toBe(false);
+    fireEvent.click(screen.getByRole("button", { name: "Return to Work" }));
+    expect((screen.getByLabelText("Native draft") as HTMLTextAreaElement).value).toBe("Original with exact edits");
+    expect(screen.getByTestId("transcript")).toBe(transcript); expect(transcript.scrollTop).toBe(120);
+    expect(screen.getByRole("button", { name: "Send message" }).hasAttribute("disabled")).toBe(true);
+    expect(mounted).toHaveBeenCalledTimes(1); expect(disposed).not.toHaveBeenCalled(); expect(send).not.toHaveBeenCalled();
+    expect(document.querySelector("iframe")).toBeNull();
+  });
+
+  it("returns a changed native binding to Work without recreating the conversation owner", () => {
+    const view = render(<NativeWorkPresentation scope="owner-a/session-a" projectName="Original"><input aria-label="Existing owner" defaultValue="retained" /></NativeWorkPresentation>);
+    const input = screen.getByLabelText("Existing owner");
+    fireEvent.click(screen.getByRole("button", { name: "Web", exact: true }));
+    view.rerender(<NativeWorkPresentation scope="owner-b/session-b" projectName="Selected"><input aria-label="Existing owner" defaultValue="retained" /></NativeWorkPresentation>);
+    expect(screen.getByRole("button", { name: "Work", exact: true }).getAttribute("aria-pressed")).toBe("true");
+    expect(screen.getByLabelText("Existing owner")).toBe(input);
+  });
+
+  it("offers explicit optional panels without invoking any operational action", () => {
+    render(<NativeWorkPresentation scope="a" projectName="Long project name"><p>Existing controller</p></NativeWorkPresentation>);
+    const tools = screen.getByRole("button", { name: "Workspace tools" });
+    const terminal = screen.getByRole("button", { name: "Terminal panel" });
+    expect(tools.getAttribute("aria-pressed")).toBe("false");
+    fireEvent.click(tools); fireEvent.click(terminal);
+    expect(tools.getAttribute("aria-pressed")).toBe("true");
+    expect(terminal.getAttribute("aria-pressed")).toBe("true");
+  });
+});
