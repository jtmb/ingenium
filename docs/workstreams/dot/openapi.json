{
  "openapi": "3.1.0",
  "info": {
    "title": "Veyra Dot consumer API proposal",
    "version": "1.0.0",
    "description": "Coordinator mounts only behind existing authenticated policy/CSRF/rate-limit middleware. Actor and scope are resolved server-side; request bodies cannot select another owner or execution binding. No route is mounted by this slice."
  },
  "servers": [
    {
      "url": "/api/v1/dot"
    }
  ],
  "security": [
    {
      "existingSession": []
    }
  ],
