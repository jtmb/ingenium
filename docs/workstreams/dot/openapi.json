  "components": {
    "securitySchemes": {
      "existingSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Logical reference to existing authenticated session/token middleware; no new Dot credential. Browser sessions keep current cookie/CSRF policy."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string"
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "executionBindingId": {
            "type": "string"
          },
          "executionBindingFingerprint": {
            "type": "string"
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "organizationId",
          "ownerUserId",
          "projectId",
          "executionBindingId",
          "executionBindingFingerprint",
          "conversationId"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Schedule": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "once"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "kind",
              "at"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "interval"
              },
              "anchor": {
                "type": "string",
                "format": "date-time"
              },
              "minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 525600
              }
            },
            "required": [
              "kind",
              "anchor",
              "minutes"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "calendar"
              },
              "timeZone": {
                "type": "string"
              },
              "hour": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 59
              },
              "fold": {
                "enum": [
                  "earlier",
                  "later",
                  "both"
                ]
              },
              "weekdays": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              }
            },
            "required": [
              "kind",
              "timeZone",
              "hour",
              "minute",
              "fold"
            ]
          }
        ]
      },
      "SuggestionInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "user",
                  "event",
                  "memory"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "reference"
            ]
          },
          "capabilities": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title",
          "prompt",
          "source",
          "capabilities",
          "expiresAt"
        ]
      },
      "ApprovalInput": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "missedPolicy": {
            "enum": [
              "skip",
              "latest",
              "all"
            ]
          },
          "notificationPolicy": {
            "enum": [
              "meaningful",
              "failures",
              "silent"
            ]
          }
        },
        "required": [
          "jobId",
          "schedule",
          "missedPolicy",
          "notificationPolicy"
        ]
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "propose"
              },
              "input": {
                "$ref": "#/components/schemas/SuggestionInput"
              }
            },
            "required": [
              "type",
              "input"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "approve"
              },
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "input": {
                "$ref": "#/components/schemas/ApprovalInput"
              }
            },
            "required": [
              "type",
              "id",
              "revision",
              "input"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "dismiss",
                  "cancel",
                  "read"
                ]
              },
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "id",
              "revision"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "pause"
              },
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "paused": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "id",
              "revision",
              "paused"
            ]
          }
        ]
      },
      "Suggestion": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuggestionInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "scope": {
                "$ref": "#/components/schemas/Scope"
              },
              "state": {
                "enum": [
                  "proposed",
                  "approved",
                  "dismissed"
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "revision",
              "scope",
              "state",
              "createdAt"
            ]
          }
        ]
      },
      "Followup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "suggestionId": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "jobRevision": {
            "type": "integer",
            "minimum": 0
          },
          "scheduleRevision": {
            "type": "integer",
            "minimum": 0
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "missedPolicy": {
            "enum": [
              "skip",
              "latest",
              "all"
            ]
          },
          "notificationPolicy": {
            "enum": [
              "meaningful",
              "failures",
              "silent"
            ]
          },
          "cursor": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": [
              "active",
              "paused",
